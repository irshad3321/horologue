<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management - Admin Panel</title>
    
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Cropper.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #333;
            min-height: 100vh;
        }

        .admin-main-content {
            margin-left: 250px;
            margin-top: 70px;
            padding: 0;
            width: calc(100% - 250px);
            min-height: calc(100vh - 70px);
        }

        .dashboard-container {
            width: 100%;
            padding: 1.5rem;
        }

        /* Page Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: #2c3e50;
            margin: 0;
        }

        .page-subtitle {
            font-size: 12px;
            color: #6c757d;
            margin: 5px 0 0 0;
        }

        .add-category-btn {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .add-category-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
        }

        /* Search and Filter Section */
        .search-filter-section {
            background: white;
            padding: 1rem;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
            margin-bottom: 1rem;
            border: 1px solid #e9ecef;
        }

        .search-row {
            display: flex;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .filter-dropdown {
            position: relative;
        }

        .filter-select {
            padding: 10px 16px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            background: white;
            font-size: 14px;
            color: #495057;
            min-width: 160px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .filter-select:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
        }

        .search-group {
            flex: 1;
            min-width: 300px;
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 12px 20px;
            padding-left: 45px;
            border: 2px solid #e9ecef;
            border-radius: 25px;
            font-size: 14px;
            color: #495057;
            background: #f8f9fa;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .search-input:focus {
            outline: none;
            border-color: #007bff;
            background: white;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
        }

        .search-input::placeholder {
            color: #adb5bd;
            font-weight: 400;
        }

        .search-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            font-size: 16px;
            pointer-events: none;
        }

        .clear-filters-btn {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(108, 117, 125, 0.2);
        }

        .clear-filters-btn:hover {
            background: linear-gradient(135deg, #495057 0%, #343a40 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
        }

        .apply-filters-btn {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0, 123, 255, 0.2);
        }

        .apply-filters-btn:hover {
            background: linear-gradient(135deg, #0056b3 0%, #003d82 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
        }

        /* Categories Table */
        .categories-table-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            width: 100%;
        }

        .categories-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .categories-table th {
            background: #f8f9fa;
            padding: 0.75rem;
            text-align: left;
            font-weight: 600;
            color: #495057;
            border-bottom: 1px solid #dee2e6;
            font-size: 13px;
            white-space: nowrap;
        }

        .categories-table th:nth-child(1) { width: 5%; }  /* S.No */
        .categories-table th:nth-child(2) { width: 8%; }  /* Image */
        .categories-table th:nth-child(3) { width: 12%; } /* Product Name */
        .categories-table th:nth-child(4) { width: 10%; } /* Brand */
        .categories-table th:nth-child(5) { width: 10%; } /* Category */
        .categories-table th:nth-child(6) { width: 18%; } /* Variants */
        .categories-table th:nth-child(7) { width: 8%; }  /* Offer */
        .categories-table th:nth-child(8) { width: 10%; } /* Status */
        .categories-table th:nth-child(9) { width: 15%; } /* Actions */

        .categories-table td {
            padding: 0.75rem;
            border-bottom: 1px solid #f1f3f4;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .categories-table tbody tr:hover {
            background: #f8f9fa;
        }

        .category-name-cell {
            font-weight: 600;
            color: #2c3e50;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .category-description-cell {
            color: #6c757d;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .product-image {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #dee2e6;
        }

        .price-cell {
            font-weight: 600;
            color: #28a745;
        }

        .stock-cell {
            text-align: center;
        }

        .stock-low {
            color: #dc3545;
            font-weight: 600;
        }

        .stock-available {
            color: #28a745;
        }

        .action-buttons {
            display: flex;
            gap: 0.25rem;
            flex-wrap: nowrap;
        }

        .action-btn {
            padding: 3px 6px;
            border: none;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 2px;
            white-space: nowrap;
            min-width: fit-content;
        }

        .btn-edit {
            background: #007bff;
            color: white;
        }

        .btn-edit:hover {
            background: #0056b3;
        }

        .btn-delete {
            background: #dc3545;
            color: white;
        }

        .btn-delete:hover {
            background: #c82333;
        }

        .btn-toggle {
            background: #6c757d;
            color: white;
        }

        .btn-toggle:hover {
            background: #545b62;
        }

        .btn-toggle.active {
            background: #28a745;
        }

        .btn-toggle.active:hover {
            background: #218838;
        }

        /* Numeric columns alignment */
        .categories-table td:nth-child(4) {
            text-align: center;
        }

        .categories-table th:nth-child(4) {
            text-align: center;
        }

        /* Pagination */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            background: white;
            border-top: 1px solid #dee2e6;
        }

        .pagination-info {
            color: #6c757d;
            font-size: 14px;
        }

        .pagination {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .pagination-btn {
            padding: 8px 12px;
            border: 1px solid #dee2e6;
            background: white;
            color: #495057;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .pagination-btn:hover {
            background: #f8f9fa;
            border-color: #007bff;
            color: #007bff;
        }

        .pagination-btn.active {
            background: #007bff;
            border-color: #007bff;
            color: white;
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .pagination-btn:disabled:hover {
            background: white;
            border-color: #dee2e6;
            color: #495057;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .empty-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: #e9ecef;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: #adb5bd;
        }

        .empty-title {
            font-size: 24px;
            font-weight: 600;
            color: #495057;
            margin-bottom: 0.5rem;
        }

        .empty-description {
            font-size: 16px;
            color: #6c757d;
            margin-bottom: 2rem;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
        }

        .modal-content {
            background-color: white;
            margin: 5% auto;
            padding: 0;
            border-radius: 12px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: modalSlideIn 0.3s ease;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            padding: 1.5rem 2rem;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 600;
            color: #2c3e50;
        }

        .close {
            color: #adb5bd;
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .close:hover {
            color: #495057;
        }

        .modal-body {
            padding: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #495057;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
        }

        .form-control.error {
            border-color: #dc3545;
        }

        .error-message {
            color: #dc3545;
            font-size: 12px;
            margin-top: 0.25rem;
        }

        .modal-footer {
            padding: 1.5rem 2rem;
            border-top: 1px solid #e9ecef;
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: #007bff;
            color: white;
        }

        .btn-primary:hover {
            background: #0056b3;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #545b62;
        }

        /* Image Crop Modal */
        .crop-modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            overflow-y: auto;
        }

        .crop-modal-content {
            background: white;
            margin: 2% auto;
            padding: 2rem;
            border-radius: 12px;
            width: 90%;
            max-width: 700px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .crop-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #dee2e6;
        }

        .crop-modal-title {
            font-size: 20px;
            font-weight: 600;
            color: #2c3e50;
        }

        .crop-close {
            font-size: 28px;
            font-weight: bold;
            color: #adb5bd;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
        }

        .crop-close:hover {
            color: #495057;
        }

        #cropperContainer {
            max-height: 400px;
            margin-bottom: 1.5rem;
            border-radius: 8px;
            overflow: hidden;
        }

        #cropperImage {
            max-width: 100%;
            max-height: 400px;
        }

        .crop-controls {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .crop-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .crop-btn-zoom-in {
            background: #007bff;
            color: white;
        }

        .crop-btn-zoom-in:hover {
            background: #0056b3;
        }

        .crop-btn-zoom-out {
            background: #6c757d;
            color: white;
        }

        .crop-btn-zoom-out:hover {
            background: #545b62;
        }

        .crop-btn-rotate {
            background: #17a2b8;
            color: white;
        }

        .crop-btn-rotate:hover {
            background: #138496;
        }

        .crop-btn-reset {
            background: #ffc107;
            color: white;
        }

        .crop-btn-reset:hover {
            background: #e0a800;
        }

        .crop-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }

        .crop-size-info {
            font-size: 12px;
            color: #6c757d;
            margin-bottom: 1rem;
            padding: 0.75rem;
            background: #f8f9fa;
            border-radius: 6px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .admin-main-content {
                margin-left: 0;
                padding: 0;
                width: 100%;
            }

            .dashboard-container {
                padding: 1rem;
            }

            .page-header {
                flex-direction: column;
                gap: 1rem;
                align-items: stretch;
            }

            .search-row {
                flex-direction: column;
            }

            .search-group {
                min-width: 100%;
            }

            .modal-content {
                margin: 10% auto;
                width: 95%;
            }

            .categories-table-container {
                overflow-x: auto;
            }

            .categories-table {
                min-width: 800px;
            }

            .action-buttons {
                flex-direction: column;
                gap: 0.25rem;
            }

            .action-btn {
                font-size: 10px;
                padding: 3px 6px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/admin-navbar') %>
    <%- include('../partials/admin-sidebar', { currentPage: 'products' }) %>
    
    <div class="admin-main-content">
        <div class="dashboard-container">
            <!-- Page Header -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Product Management</h1>
                    <p class="page-subtitle">Manage products, images, and inventory</p>
                </div>
                <button class="add-category-btn" onclick="window.location.href='/admin/add-product'">
                    <i class="fas fa-plus"></i>
                    Add Product
                </button>
            </div>

            <!-- Search and Filter Section -->
            <div class="search-filter-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="font-size: 16px; font-weight: 600; color: #2c3e50; margin: 0;">
                        <i class="fas fa-filter" style="margin-right: 0.5rem;"></i>
                        Filter & Search Products
                    </h3>
                    <!-- <a href="#" style="color: #007bff; font-size: 14px; text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
                        Advanced Filters
                        <i class="fas fa-chevron-down"></i>
                    </a> -->
                </div>
                
                <form method="GET" action="/admin/products" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
                    <!-- Search Input -->
                    <div style="flex: 1; min-width: 250px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #6c757d; margin-bottom: 0.5rem; text-transform: uppercase;">Search</label>
                        <div style="position: relative;">
                            <i class="fas fa-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #adb5bd; font-size: 14px;"></i>
                            <input type="text" 
                                   name="search" 
                                   class="search-input" 
                                   placeholder="Search by name or brand..." 
                                   value="<%= typeof search !== 'undefined' ? search : '' %>"
                                   style="padding-left: 40px;">
                        </div>
                    </div>

                    <!-- Status Filter -->
                    <div style="min-width: 200px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #6c757d; margin-bottom: 0.5rem; text-transform: uppercase;">Status</label>
                        <select name="status" class="filter-select" style="width: 100%;">
                            <option value="">All Products</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>

                    <!-- Category Filter -->
                    <div style="min-width: 200px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #6c757d; margin-bottom: 0.5rem; text-transform: uppercase;">Category</label>
                        <select name="category" class="filter-select" style="width: 100%;">
                            <option value="">All Categories</option>
                            <option value="Analogue Watch">Analogue Watch</option>
                            <option value="Digital Watch">Digital Watch</option>
                        </select>
                    </div>

                    <!-- Sort By -->
                    <div style="min-width: 200px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #6c757d; margin-bottom: 0.5rem; text-transform: uppercase;">Sort By</label>
                        <select name="sort" class="filter-select" style="width: 100%;">
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                            <option value="name-asc">Name (A-Z)</option>
                            <option value="name-desc">Name (Z-A)</option>
                            <option value="price-asc">Price (Low to High)</option>
                            <option value="price-desc">Price (High to Low)</option>
                        </select>
                    </div>

                    <!-- Apply Filters Button -->
                    <button type="submit" class="apply-filters-btn">
                        <i class="fas fa-search"></i>
                        Apply Filters
                    </button>
                </form>
            </div>

            <!-- Categories Table -->
            <div class="categories-table-container">
                <table class="categories-table">
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Image</th>
                            <th>Product Name</th>
                            <th>Brand</th>
                            <th>Category</th>
                            <th>Variants</th>
                            <th>Offer</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                        // Use products from controller
                        const displayProducts = typeof products !== 'undefined' ? products : [];
                        const currentPage = typeof currentPageNum !== 'undefined' ? currentPageNum : 1;
                        const itemsPerPage = 10;
                        const totalItems = typeof total !== 'undefined' ? total : displayProducts.length;
                        const totalPagesCalc = typeof totalPages !== 'undefined' ? totalPages : Math.ceil(totalItems / itemsPerPage);
                        const startIndex = (currentPage - 1) * itemsPerPage;
                        const endIndex = startIndex + itemsPerPage;
                        %>
                        
                        <% if (displayProducts.length > 0) { %>
                            <% displayProducts.forEach((product, index) => { %>
                                <tr>
                                    <td class="serial-number"><%= startIndex + index + 1 %></td>
                                    <td>
                                        <% 
                                        // Get first variant's first image or placeholder
                                        let productImage = 'https://via.placeholder.com/40?text=No+Image';
                                        if (product.variants && product.variants.length > 0 && product.variants[0].images && product.variants[0].images.length > 0) {
                                            productImage = product.variants[0].images[0].url;
                                        }
                                        %>
                                        <img src="<%= productImage %>" alt="<%= product.name %>" class="product-image">
                                    </td>
                                    <td class="category-name-cell"><%= product.name %></td>
                                    <td><%= product.brand %></td>
                                    <td><%= product.category %></td>
                                    <td>
                                        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                            <% if (product.variants && product.variants.length > 0) { %>
                                                <% product.variants.forEach(variant => { %>
                                                    <span style="background: #e9ecef; color: #495057; padding: 0.35rem 0.75rem; border-radius: 20px; font-size: 12px; font-weight: 500; white-space: nowrap;">
                                                        <%= variant.color %> : ₹<%= parseFloat(variant.price).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                                    </span>
                                                <% }); %>
                                            <% } else { %>
                                                <span style="color: #6c757d; font-size: 12px;">No variants</span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td style="text-align: center; font-weight: 600; color: #dc3545;"><%= product.offer %>%</td>
                                    <td>
                                        <span class="status-badge status-<%= product.status === 'active' ? 'active' : 'inactive' %>">
                                            <%= product.status === 'active' ? 'ACTIVE' : 'INACTIVE' %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="action-btn btn-edit" onclick="editProduct('<%= product._id %>')" title="Edit Product">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="action-btn btn-toggle <%= product.status === 'active' ? 'active' : '' %>" 
                                                    onclick="toggleProduct('<%= product._id %>', '<%= product.status %>')" 
                                                    title="<%= product.status === 'active' ? 'Disable Product' : 'Enable Product' %>">
                                                <i class="fas fa-<%= product.status === 'active' ? 'eye-slash' : 'eye' %>"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" style="text-align: center; padding: 3rem; color: #6c757d;">
                                    <i class="fas fa-search" style="font-size: 48px; margin-bottom: 1rem; opacity: 0.5;"></i>
                                    <div style="font-size: 18px; font-weight: 600; margin-bottom: 0.5rem;">No Products Found</div>
                                    <div>Try adjusting your search criteria or add a new product.</div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
                
                <!-- Pagination -->
                <% if (totalPagesCalc > 1) { %>
                    <div class="pagination-container">
                        <div class="pagination-info">
                            Showing <%= startIndex + 1 %> to <%= Math.min(endIndex, totalItems) %> of <%= totalItems %> products
                        </div>
                        <div class="pagination">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" 
                                   class="pagination-btn">
                                    <i class="fas fa-chevron-left"></i>
                                    Previous
                                </a>
                            <% } %>
                            
                            <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPagesCalc, currentPage + 2); i++) { %>
                                <a href="?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" 
                                   class="pagination-btn <%= i === currentPage ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                            <% } %>
                            
                            <% if (currentPage < totalPagesCalc) { %>
                                <a href="?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" 
                                   class="pagination-btn">
                                    Next
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Add/Edit Product Modal -->
    <div id="categoryModal" class="modal">
        <div class="modal-content" style="max-width: 600px; max-height: 90vh; overflow-y: auto;">
            <div class="modal-header">
                <h2 class="modal-title" id="modalTitle">Add New Product</h2>
                <span class="close" onclick="closeModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <div class="form-group">
                        <label class="form-label" for="categoryName">Product Name *</label>
                        <input type="text" id="categoryName" class="form-control" placeholder="Enter product name" required>
                        <div class="error-message" id="nameError"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="categoryDescription">Description</label>
                        <textarea id="categoryDescription" class="form-control" rows="3" placeholder="Enter product description"></textarea>
                        <div class="error-message" id="descriptionError"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="categoryStatus">Status</label>
                        <select id="categoryStatus" class="form-control">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    
                    <!-- Variants Section -->
                    <div class="form-group">
                        <label class="form-label">Product Variants (Maximum 3) *</label>
                        <div id="variantsContainer" style="display: flex; flex-direction: column; gap: 1rem;">
                            <div class="variant-item" style="display: flex; gap: 0.75rem; align-items: flex-end;">
                                <div style="flex: 1;">
                                    <label style="font-size: 12px; color: #6c757d; display: block; margin-bottom: 0.25rem;">Color</label>
                                    <input type="text" class="form-control variant-color" placeholder="e.g., White" required>
                                </div>
                                <div style="flex: 1;">
                                    <label style="font-size: 12px; color: #6c757d; display: block; margin-bottom: 0.25rem;">Price</label>
                                    <input type="number" class="form-control variant-price" placeholder="e.g., 2000" step="0.01" required>
                                </div>
                                <button type="button" class="action-btn btn-delete" onclick="removeVariant(this)" style="padding: 8px 12px;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary" onclick="addVariant()" style="margin-top: 1rem; width: 100%; background: #17a2b8;" id="addVariantBtn">
                            <i class="fas fa-plus"></i> Add Variant
                        </button>
                        <div class="error-message" id="variantsError"></div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Product Images (Minimum 3) *</label>
                        <div style="border: 2px dashed #dee2e6; border-radius: 8px; padding: 1.5rem; text-align: center; cursor: pointer;" onclick="document.getElementById('imageInput').click()">
                            <i class="fas fa-cloud-upload-alt" style="font-size: 28px; color: #6c757d; margin-bottom: 0.75rem;"></i>
                            <p style="color: #6c757d; margin: 0.5rem 0; font-size: 13px;">Drag and drop images here or click to select</p>
                            <small style="color: #adb5bd;">Minimum 3 images required. You can crop and resize before uploading.</small>
                        </div>
                        <input type="file" id="imageInput" multiple accept="image/*" style="display: none;" onchange="handleImageSelect(event)">
                        <div id="imagePreview" style="display: flex; gap: 1rem; margin-top: 1rem; flex-wrap: wrap;"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">Save Product</button>
            </div>
        </div>
    </div>

    <!-- Session Protection Script -->
    <script src="/js/session-protection.js"></script>

    <!-- Image Crop Modal -->
    <div id="cropModal" class="crop-modal">
        <div class="crop-modal-content">
            <div class="crop-modal-header">
                <h2 class="crop-modal-title">Crop & Resize Image</h2>
                <button class="crop-close" onclick="closeCropModal()">&times;</button>
            </div>
            <div class="crop-size-info">
                <strong>Recommended Size:</strong> 800x800px for best quality. You can zoom, rotate, and crop the image below.
            </div>
            <div id="cropperContainer">
                <img id="cropperImage" src="" alt="Crop Image">
            </div>
            <div class="crop-controls">
                <button class="crop-btn crop-btn-zoom-in" onclick="zoomIn()">
                    <i class="fas fa-search-plus"></i>
                    Zoom In
                </button>
                <button class="crop-btn crop-btn-zoom-out" onclick="zoomOut()">
                    <i class="fas fa-search-minus"></i>
                    Zoom Out
                </button>
                <button class="crop-btn crop-btn-rotate" onclick="rotateImage()">
                    <i class="fas fa-redo"></i>
                    Rotate 90°
                </button>
                <button class="crop-btn crop-btn-reset" onclick="resetCropper()">
                    <i class="fas fa-undo"></i>
                    Reset
                </button>
            </div>
            <div class="crop-modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeCropModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCroppedImage()">Save & Continue</button>
            </div>
        </div>
    </div>

    <script>
        // Clear Search Function
        function clearSearch() {
            window.location.href = '/admin/products';
        }
        function openAddModal() {
            editingCategoryId = null;
            document.getElementById('modalTitle').textContent = 'Add New Product';
            document.getElementById('categoryForm').reset();
            document.getElementById('imagePreview').innerHTML = '';
            clearErrors();
            document.getElementById('categoryModal').style.display = 'block';
        }

        // Open Edit Modal
        function editProduct(productId) {
            window.location.href = `/admin/edit-product/${productId}`;
        }

        // Handle Image Selection
        function handleImageSelect(event) {
            const files = event.target.files;
            const preview = document.getElementById('imagePreview');
            
            if (files.length < 3) {
                alert('Please select at least 3 images');
                return;
            }
            
            preview.innerHTML = '';
            
            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const div = document.createElement('div');
                    div.style.position = 'relative';
                    div.style.width = '100px';
                    div.style.height = '100px';
                    
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.width = '100%';
                    img.style.height = '100%';
                    img.style.objectFit = 'cover';
                    img.style.borderRadius = '6px';
                    img.style.border = '1px solid #dee2e6';
                    img.style.cursor = 'pointer';
                    img.onclick = () => openCropModal(e.target.result, index);
                    
                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.innerHTML = '<i class="fas fa-times"></i>';
                    removeBtn.style.position = 'absolute';
                    removeBtn.style.top = '-8px';
                    removeBtn.style.right = '-8px';
                    removeBtn.style.width = '24px';
                    removeBtn.style.height = '24px';
                    removeBtn.style.borderRadius = '50%';
                    removeBtn.style.background = '#dc3545';
                    removeBtn.style.color = 'white';
                    removeBtn.style.border = 'none';
                    removeBtn.style.cursor = 'pointer';
                    removeBtn.onclick = (e) => {
                        e.preventDefault();
                        div.remove();
                    };
                    
                    div.appendChild(img);
                    div.appendChild(removeBtn);
                    preview.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        }

        // Open Crop Modal
        function openCropModal(imageSrc, index) {
            Swal.fire({
                title: 'Crop Image',
                html: `<img id="cropImage" src="${imageSrc}" style="max-width: 100%; max-height: 400px;">`,
                showCancelButton: true,
                confirmButtonText: 'Crop & Save',
                didOpen: () => {
                    // Cropper.js integration would go here
                    // For now, just showing the image
                }
            });
        }

        // Close Modal
        function closeModal() {
            document.getElementById('categoryModal').style.display = 'none';
            editingCategoryId = null;
        }

        // Save Product
        function saveCategory() {
            const name = document.getElementById('categoryName').value.trim();
            const description = document.getElementById('categoryDescription').value.trim();
            const status = document.getElementById('categoryStatus').value;
            const images = document.getElementById('imagePreview').querySelectorAll('img');

            // Clear previous errors
            clearErrors();

            // Validation
            let hasErrors = false;

            if (!name) {
                showError('nameError', 'Product name is required');
                hasErrors = true;
            }

            if (images.length < 3) {
                alert('Please upload at least 3 images');
                hasErrors = true;
            }

            if (hasErrors) {
                return;
            }

            // Show loading
            Swal.fire({
                title: 'Saving...',
                text: 'Please wait while we save the product',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Simulate API call - replace with actual backend call
            setTimeout(() => {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: editingCategoryId ? 'Product updated successfully' : 'Product created successfully',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    // Reload page to show updated data
                    window.location.reload();
                });

                closeModal();
            }, 1500);
        }

        // Toggle Product Status
        function toggleProduct(productId, currentStatus) {
            const newStatus = currentStatus === 'active' ? 'inactive' : 'active';
            const action = newStatus === 'active' ? 'enable' : 'disable';
            
            Swal.fire({
                title: `${action.charAt(0).toUpperCase() + action.slice(1)} Product?`,
                text: `Are you sure you want to ${action} this product?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#007bff',
                cancelButtonColor: '#6c757d',
                confirmButtonText: `Yes, ${action.charAt(0).toUpperCase() + action.slice(1)}`,
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loading
                    Swal.fire({
                        title: 'Updating...',
                        text: 'Please wait while we update the product status',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Simulate API call - replace with actual backend call
                    setTimeout(() => {
                        Swal.fire({
                            icon: 'success',
                            title: 'Status Updated!',
                            text: `Product has been ${action}d successfully`,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            // Reload page to show updated data
                            window.location.reload();
                        });
                    }, 1000);
                }
            });
        }

        // Delete Product (Soft Delete)
        function deleteProduct(productId) {
            Swal.fire({
                title: 'Delete Product?',
                text: 'This product will be moved to trash. You can restore it later if needed.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loading
                    Swal.fire({
                        title: 'Deleting...',
                        text: 'Please wait while we delete the product',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Simulate API call - replace with actual backend call
                    setTimeout(() => {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Product has been deleted successfully',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            // Reload page to show updated data
                            window.location.reload();
                        });
                    }, 1000);
                }
            });
        }

        // Utility Functions
        function showError(elementId, message) {
            const errorElement = document.getElementById(elementId);
            const inputElement = errorElement.previousElementSibling;
            
            errorElement.textContent = message;
            inputElement.classList.add('error');
        }

        function clearErrors() {
            const errorElements = document.querySelectorAll('.error-message');
            const inputElements = document.querySelectorAll('.form-control');
            
            errorElements.forEach(el => el.textContent = '');
            inputElements.forEach(el => el.classList.remove('error'));
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('categoryModal');
            if (event.target === modal) {
                closeModal();
            }
        }
    </script>
</body>
</html>