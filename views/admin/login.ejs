<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Login - Horologue</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #e8ecef 0%, #d6dde4 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    .header {
      background: #000;
      color: #fff;
      padding: 20px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: 1px;
    }

    .logo svg {
      width: 28px;
      height: 28px;
    }

    .admin-info {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 16px;
      font-weight: 500;
    }

    .admin-info svg {
      width: 20px;
      height: 20px;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 20px;
    }

    .login-container {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 50px 60px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 450px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .login-title {
      font-size: 32px;
      font-weight: 600;
      color: #333;
      text-align: center;
      margin-bottom: 40px;
      letter-spacing: -0.5px;
    }

    .form-group {
      margin-bottom: 25px;
    }

    .form-group label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      color: #555;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-input {
      width: 100%;
      padding: 16px 20px;
      border: 2px solid #e1e5e9;
      border-radius: 12px;
      font-size: 16px;
      color: #333;
      background: #fff;
      transition: all 0.3s ease;
      outline: none;
    }

    .form-input:focus {
      border-color: #000;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
    }

    .password-input-container {
      position: relative;
      display: flex;
      align-items: center;
    }

    .password-field {
      padding-right: 50px;
    }

    .password-toggle {
      position: absolute;
      right: 15px;
      background: none;
      border: none;
      cursor: pointer;
      color: #666;
      font-size: 16px;
      padding: 5px;
      transition: color 0.3s ease;
    }

    .password-toggle:hover {
      color: #000;
    }

    .password-toggle:focus {
      outline: none;
    }

    .form-input::placeholder {
      color: #aaa;
      font-size: 15px;
    }

    .forgot-password {
      text-align: right;
      margin-top: 8px;
    }

    .forgot-password a {
      color: #666;
      text-decoration: none;
      font-size: 13px;
      transition: color 0.3s ease;
    }

    .forgot-password a:hover {
      color: #000;
    }

    .login-btn {
      width: 100%;
      padding: 18px;
      background: #000;
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: 30px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .login-btn:hover {
      background: #333;
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    }

    .login-btn:active {
      transform: translateY(0);
    }

    /* Alert Messages */
    .alert {
      padding: 15px 20px;
      border-radius: 12px;
      margin-bottom: 25px;
      font-size: 14px;
      font-weight: 500;
    }

    .alert-error {
      background-color: #fee;
      color: #c53030;
      border: 1px solid #feb2b2;
    }

    .alert-success {
      background-color: #f0fff4;
      color: #2f855a;
      border: 1px solid #9ae6b4;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .header {
        padding: 15px 20px;
      }

      .logo {
        font-size: 24px;
      }

      .admin-info {
        font-size: 14px;
      }

      .login-container {
        padding: 40px 30px;
        margin: 20px;
        border-radius: 16px;
      }

      .login-title {
        font-size: 28px;
        margin-bottom: 30px;
      }

      .form-input {
        padding: 14px 16px;
        font-size: 15px;
      }

      .login-btn {
        padding: 16px;
        font-size: 15px;
      }
    }

    @media (max-width: 480px) {
      .main-content {
        padding: 40px 15px;
      }

      .login-container {
        padding: 30px 20px;
      }

      .login-title {
        font-size: 24px;
      }
    }

    /* Loading state */
    .login-btn.loading {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .login-btn.loading::after {
      content: '';
      width: 16px;
      height: 16px;
      border: 2px solid transparent;
      border-top: 2px solid #fff;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      display: inline-block;
      margin-left: 10px;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <%- include('../partials/toast') %>

  <!-- Header -->
  <div class="header">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      Horologue
    </div>
    <div class="admin-info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      ADMIN
    </div>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <div class="login-container">
      <h1 class="login-title">Admin Login</h1>

      <!-- Error and Success Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" id="errorAlert">
          <%= error %>
        </div>
      <% } %>
      
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
          <%= success %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" autocomplete="off">
        <!-- Hidden fake fields to trick browsers -->
        <input type="text" style="display:none" />
        <input type="password" style="display:none" />
        
        <div class="form-group">
          <label for="email">Email</label>
          <input 
            type="email" 
            id="email"
            name="email" 
            class="form-input"
            placeholder="Enter your email"
            autocomplete="new-email"
            readonly
            onfocus="this.removeAttribute('readonly')"
            value=""
            required 
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="password-input-container">
            <input 
              type="password" 
              id="password"
              name="password" 
              class="form-input password-field"
              placeholder="Enter your password"
              autocomplete="new-password"
              readonly
              onfocus="this.removeAttribute('readonly')"
              value=""
              required 
            />
            <button type="button" class="password-toggle" onclick="togglePasswordVisibility()">
              <i class="fas fa-eye" id="passwordToggleIcon"></i>
            </button>
          </div>
          <div class="forgot-password">
            <a href="/admin/forgot-password">Forgot Password?</a>
          </div>
        </div>

        <button type="submit" class="login-btn" id="loginBtn">
          Login
        </button>
      </form>
    </div>
  </div>

  <script>
    // Prevent back button access after login
    (function() {
      if (window.history && window.history.pushState) {
        window.history.pushState('forward', null, './');
        window.addEventListener('popstate', function() {
          window.history.pushState('forward', null, './');
        });
      }
    })();

    // Disable browser cache for this page
    window.addEventListener('pageshow', function(event) {
      if (event.persisted) {
        window.location.reload();
      }
    });

    // Aggressive autofill prevention
    document.addEventListener('DOMContentLoaded', function() {
      const emailField = document.getElementById('email');
      const passwordField = document.getElementById('password');
      
      // Clear fields immediately
      emailField.value = '';
      passwordField.value = '';
      
      // Multiple clearing attempts with different delays
      setTimeout(() => {
        emailField.value = '';
        passwordField.value = '';
      }, 50);
      
      setTimeout(() => {
        emailField.value = '';
        passwordField.value = '';
      }, 100);
      
      setTimeout(() => {
        emailField.value = '';
        passwordField.value = '';
      }, 200);
      
      setTimeout(() => {
        emailField.value = '';
        passwordField.value = '';
      }, 500);
      
      // Auto-focus on email field after clearing
      setTimeout(() => {
        emailField.focus();
      }, 600);
    });

    // Monitor for any changes and clear if autofilled
    setInterval(() => {
      const emailField = document.getElementById('email');
      const passwordField = document.getElementById('password');
      
      // If fields have values but user hasn't interacted, clear them
      if (emailField.value && !emailField.dataset.userInput) {
        emailField.value = '';
      }
      if (passwordField.value && !passwordField.dataset.userInput) {
        passwordField.value = '';
      }
    }, 100);

    // Mark when user actually types
    document.getElementById('email').addEventListener('input', function() {
      this.dataset.userInput = 'true';
    });
    
    document.getElementById('password').addEventListener('input', function() {
      this.dataset.userInput = 'true';
    });

    // Auto-hide error message after 5 seconds
    const errorAlert = document.getElementById('errorAlert');
    if (errorAlert) {
      setTimeout(() => {
        errorAlert.style.transition = 'opacity 0.5s ease-out';
        errorAlert.style.opacity = '0';
        setTimeout(() => {
          errorAlert.style.display = 'none';
        }, 500);
      }, 5000); // Hide after 5 seconds
    }

    // Password visibility toggle function
    function togglePasswordVisibility() {
      const passwordField = document.getElementById('password');
      const toggleIcon = document.getElementById('passwordToggleIcon');
      
      if (passwordField.type === 'password') {
        passwordField.type = 'text';
        toggleIcon.classList.remove('fa-eye');
        toggleIcon.classList.add('fa-eye-slash');
      } else {
        passwordField.type = 'password';
        toggleIcon.classList.remove('fa-eye-slash');
        toggleIcon.classList.add('fa-eye');
      }
    }

    // Make toggle function globally available
    window.togglePasswordVisibility = togglePasswordVisibility;

    // Form submission with loading state
    document.querySelector('form').addEventListener('submit', function() {
      const btn = document.getElementById('loginBtn');
      btn.classList.add('loading');
      btn.disabled = true;
    });

    // Enter key navigation
    document.getElementById('email').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        document.getElementById('password').focus();
      }
    });

    // Clear on focus if not user input
    document.getElementById('email').addEventListener('focus', function() {
      if (!this.dataset.userInput && this.value) {
        this.value = '';
      }
    });

    document.getElementById('password').addEventListener('focus', function() {
      if (!this.dataset.userInput && this.value) {
        this.value = '';
      }
    });
  </script>
</body>
</html>