<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Horologue</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <!-- Admin Navbar -->
    <%- include('../partials/admin-navbar') %>
    
    <!-- Admin Sidebar -->
    <%- include('../partials/admin-sidebar', { currentPage: 'dashboard' }) %>
    
    <!-- Main Content -->
    <div class="admin-main-content">
        <div class="dashboard-container">
            <!-- Stats Cards -->
            <div class="row mb-4">
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="stats-card stats-users">
                        <div class="stats-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stats-content">
                            <h3>Total User</h3>
                            <div class="stats-number">40,689</div>
                            <div class="stats-change positive">
                                <i class="fas fa-arrow-up"></i>
                                8.5% Up from last month
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="stats-card stats-orders">
                        <div class="stats-icon">
                            <i class="fas fa-box"></i>
                        </div>
                        <div class="stats-content">
                            <h3>Total Order</h3>
                            <div class="stats-number">10293</div>
                            <div class="stats-change positive">
                                <i class="fas fa-arrow-up"></i>
                                1.3% Up from last month
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="stats-card stats-sales">
                        <div class="stats-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="stats-content">
                            <h3>Total Sales</h3>
                            <div class="stats-number">$89,000</div>
                            <div class="stats-change negative">
                                <i class="fas fa-arrow-down"></i>
                                4.3% Down from last month
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Sales Chart -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h4>Sales Details</h4>
                            <div class="chart-controls">
                                <select class="form-select form-select-sm">
                                    <option>Today</option>
                                    <option>This Week</option>
                                    <option>This Month</option>
                                </select>
                                <select class="form-select form-select-sm">
                                    <option>October</option>
                                    <option>November</option>
                                    <option>December</option>
                                </select>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Recent Orders Table -->
            <div class="row">
                <div class="col-12">
                    <div class="table-card">
                        <div class="table-header">
                            <h4>Recent Orders</h4>
                        </div>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>NAME</th>
                                        <th>ADDRESS</th>
                                        <th>DATE</th>
                                        <th>TYPE</th>
                                        <th>STATUS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>00001</td>
                                        <td>Rolex Submariner</td>
                                        <td>089 Kutch Green Apt. 448</td>
                                        <td>04 Sep 2019</td>
                                        <td>Analogue</td>
                                        <td><span class="badge status-completed">Completed</span></td>
                                    </tr>
                                    <tr>
                                        <td>00002</td>
                                        <td>Omega Speedmaster</td>
                                        <td>979 Immanuel Ferry Suite 526</td>
                                        <td>28 May 2019</td>
                                        <td>Digital</td>
                                        <td><span class="badge status-processing">Processing</span></td>
                                    </tr>
                                    <tr>
                                        <td>00003</td>
                                        <td>TAG Heuer Carrera</td>
                                        <td>8587 Frida Ports</td>
                                        <td>23 Nov 2019</td>
                                        <td>Analogue</td>
                                        <td><span class="badge status-rejected">Rejected</span></td>
                                    </tr>
                                    <tr>
                                        <td>00004</td>
                                        <td>Breitling Navitimer</td>
                                        <td>123 Watch Street Suite 100</td>
                                        <td>15 Dec 2019</td>
                                        <td>Chronograph</td>
                                        <td><span class="badge status-completed">Completed</span></td>
                                    </tr>
                                    <tr>
                                        <td>00005</td>
                                        <td>Patek Philippe Calatrava</td>
                                        <td>456 Luxury Avenue Apt. 789</td>
                                        <td>02 Jan 2020</td>
                                        <td>Dress Watch</td>
                                        <td><span class="badge status-processing">Processing</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .admin-main-content {
            margin-left: 250px;
            margin-top: 70px;
            padding: 2rem;
            min-height: calc(100vh - 70px);
        }

        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Stats Cards */
        .stats-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e9ecef;
            height: 100%;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .stats-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }

        .stats-users .stats-icon {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .stats-orders .stats-icon {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .stats-sales .stats-icon {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .stats-content h3 {
            font-size: 0.9rem;
            color: #6c757d;
            margin: 0 0 0.5rem 0;
            font-weight: 500;
        }

        .stats-number {
            font-size: 1.8rem;
            font-weight: 700;
            color: #212529;
            margin-bottom: 0.5rem;
        }

        .stats-change {
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .stats-change.positive {
            color: #28a745;
        }

        .stats-change.negative {
            color: #dc3545;
        }

        /* Chart Card */
        .chart-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e9ecef;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .chart-header h4 {
            margin: 0;
            color: #212529;
            font-weight: 600;
        }

        .chart-controls {
            display: flex;
            gap: 1rem;
        }

        .chart-controls .form-select {
            width: auto;
            min-width: 120px;
        }

        .chart-container {
            height: 400px;
            position: relative;
        }

        /* Table Card */
        .table-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e9ecef;
        }

        .table-header {
            margin-bottom: 1.5rem;
        }

        .table-header h4 {
            margin: 0;
            color: #212529;
            font-weight: 600;
        }

        .table {
            margin: 0;
        }

        .table th {
            border-top: none;
            border-bottom: 2px solid #e9ecef;
            font-weight: 600;
            color: #495057;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
        }

        .table td {
            border-top: 1px solid #f1f3f4;
            padding: 1rem 0.75rem;
            vertical-align: middle;
            font-size: 0.9rem;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        /* Status Badges */
        .badge {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .status-completed {
            background-color: #d4edda;
            color: #155724;
        }

        .status-processing {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .status-rejected {
            background-color: #f8d7da;
            color: #721c24;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .admin-main-content {
                margin-left: 0;
                padding: 1rem;
            }

            .stats-card {
                flex-direction: column;
                text-align: center;
            }

            .chart-header {
                flex-direction: column;
                gap: 1rem;
                align-items: stretch;
            }

            .chart-controls {
                justify-content: center;
            }

            .chart-container {
                height: 300px;
            }
        }
    </style>

    <!-- Session Protection Script -->
    <script src="/js/session-protection.js"></script>

    <script>
        // Sales Chart
        const ctx = document.getElementById('salesChart').getContext('2d');
        const salesChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['5k', '10k', '15k', '20k', '25k', '30k', '35k', '40k', '45k', '50k', '55k', '60k'],
                datasets: [{
                    label: 'Sales',
                    data: [20, 30, 45, 50, 85, 40, 55, 70, 60, 75, 65, 80],
                    borderColor: '#007bff',
                    backgroundColor: 'rgba(0, 123, 255, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#007bff',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            callback: function(value) {
                                return value + '%';
                            }
                        },
                        grid: {
                            color: '#f1f3f4'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                },
                elements: {
                    point: {
                        hoverBackgroundColor: '#007bff'
                    }
                }
            }
        });
    </script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>