<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Horologue</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f8f9fa;
        }

        .admin-main-content {
            margin-left: 250px;
            margin-top: 70px;
            padding: 2rem;
            min-height: calc(100vh - 70px);
        }

        .dashboard-header {
            margin-bottom: 2rem;
        }

        .dashboard-title {
            font-size: 28px;
            font-weight: 700;
            color: #2c3e50;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .stat-icon.users { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .stat-icon.orders { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
        .stat-icon.sales { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
        .stat-icon.products { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }

        .stat-content h3 {
            font-size: 14px;
            color: #6c757d;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
            color: #2c3e50;
        }

        /* Chart Section */
        .chart-section {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            margin-bottom: 2rem;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .chart-title {
            font-size: 20px;
            font-weight: 700;
            color: #2c3e50;
        }

        .chart-filters {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-btn {
            padding: 8px 16px;
            border: 2px solid #e9ecef;
            background: white;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn.active {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }

        .filter-btn:hover {
            border-color: #667eea;
        }

        .date-input {
            padding: 8px 12px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .date-input:focus {
            outline: none;
            border-color: #667eea;
        }

        .btn-download {
            padding: 8px 16px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-download:hover {
            background: #218838;
            transform: translateY(-2px);
        }

        .chart-container {
            height: 400px;
            position: relative;
        }

        /* Best Selling Section */
        .best-selling-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .best-selling-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .card-title {
            font-size: 18px;
            font-weight: 700;
            color: #2c3e50;
        }

        .item-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .item:hover {
            background: #f8f9fa;
        }

        .item-info {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }

        .item-rank {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .item-rank.gold { background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); }
        .item-rank.silver { background: linear-gradient(135deg, #bdc3c7 0%, #95a5a6 100%); }
        .item-rank.bronze { background: linear-gradient(135deg, #cd7f32 0%, #b87333 100%); }

        .item-details {
            flex: 1;
        }

        .item-name {
            font-weight: 600;
            color: #2c3e50;
            font-size: 14px;
            margin-bottom: 4px;
        }

        .item-meta {
            font-size: 12px;
            color: #6c757d;
        }

        .item-stats {
            text-align: right;
        }

        .item-value {
            font-weight: 700;
            color: #2c3e50;
            font-size: 16px;
        }

        .item-count {
            font-size: 12px;
            color: #6c757d;
        }

        .no-data {
            text-align: center;
            padding: 2rem;
            color: #6c757d;
        }

        @media (max-width: 768px) {
            .admin-main-content {
                margin-left: 0;
                padding: 1rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .best-selling-grid {
                grid-template-columns: 1fr;
            }

            .chart-container {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/admin-navbar') %>
    <%- include('../partials/admin-sidebar', { currentPage: 'dashboard' }) %>
    
    <div class="admin-main-content">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Dashboard Overview</h1>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon users">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-content">
                    <h3>Total Users</h3>
                    <div class="stat-value" id="totalUsers">-</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon orders">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stat-content">
                    <h3>Total Orders</h3>
                    <div class="stat-value" id="totalOrders">-</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon sales">
                    <i class="fas fa-rupee-sign"></i>
                </div>
                <div class="stat-content">
                    <h3>Total Revenue</h3>
                    <div class="stat-value" id="totalRevenue">-</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon products">
                    <i class="fas fa-box"></i>
                </div>
                <div class="stat-content">
                    <h3>Total Products</h3>
                    <div class="stat-value" id="totalProducts">-</div>
                </div>
            </div>
        </div>

        <!-- Sales Chart -->
        <div class="chart-section">
            <div class="chart-header">
                <h2 class="chart-title">Sales Analytics</h2>
                <div class="chart-filters">
                    <button class="filter-btn" onclick="filterChart('daily')">Daily</button>
                    <button class="filter-btn" onclick="filterChart('weekly')">Weekly</button>
                    <button class="filter-btn active" onclick="filterChart('monthly')">Monthly</button>
                    <button class="filter-btn" onclick="filterChart('yearly')">Yearly</button>
                    <button class="filter-btn" onclick="showCustomDateFilter()">Custom</button>
                    <div id="customDateInputs" style="display: none; gap: 0.5rem;">
                        <input type="date" id="customStartDate" class="date-input" placeholder="Start Date">
                        <input type="date" id="customEndDate" class="date-input" placeholder="End Date">
                        <button class="filter-btn" onclick="applyCustomFilter()">Apply</button>
                    </div>
                    <button class="btn-download" onclick="downloadDashboardPDF()">
                        <i class="fas fa-download"></i> Download PDF
                    </button>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="salesChart"></canvas>
            </div>
        </div>

        <!-- Best Selling Products, Categories, Brands -->
        <div class="best-selling-grid">
            <!-- Best Selling Products -->
            <div class="best-selling-card">
                <div class="card-header">
                    <h3 class="card-title">Top 10 Products</h3>
                </div>
                <div class="item-list" id="topProducts">
                    <div class="no-data">Loading...</div>
                </div>
            </div>

            <!-- Best Selling Categories -->
            <div class="best-selling-card">
                <div class="card-header">
                    <h3 class="card-title">Top 10 Categories</h3>
                </div>
                <div class="item-list" id="topCategories">
                    <div class="no-data">Loading...</div>
                </div>
            </div>

            <!-- Best Selling Brands -->
            <div class="best-selling-card">
                <div class="card-header">
                    <h3 class="card-title">Top 10 Brands</h3>
                </div>
                <div class="item-list" id="topBrands">
                    <div class="no-data">Loading...</div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/session-protection.js"></script>
    <script>
        let currentChart = null;
        let currentFilter = 'monthly';
        let customStartDate = null;
        let customEndDate = null;

        // Load dashboard stats
        async function loadStats(filter = 'all', startDate = null, endDate = null) {
            try {
                let url = `/admin/api/dashboard/stats?filter=${filter}`;
                if (filter === 'custom' && startDate && endDate) {
                    url += `&startDate=${startDate}&endDate=${endDate}`;
                }
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.success) {
                    document.getElementById('totalUsers').textContent = data.stats.totalUsers.toLocaleString('en-IN');
                    document.getElementById('totalOrders').textContent = data.stats.totalOrders.toLocaleString('en-IN');
                    const rev = data.stats.totalRevenue;
                    document.getElementById('totalRevenue').textContent = rev >= 100000 
                        ? '₹' + (rev / 100000).toFixed(1) + 'L' 
                        : '₹' + rev.toLocaleString('en-IN');
                    document.getElementById('totalProducts').textContent = data.stats.totalProducts.toLocaleString('en-IN');
                }
            } catch (error) {
                console.error('Failed to load stats:', error);
            }
        }

        function showCustomDateFilter() {
            const customInputs = document.getElementById('customDateInputs');
            customInputs.style.display = 'flex';
            
            // Update active button
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
        }

        async function applyCustomFilter() {
            const startDate = document.getElementById('customStartDate').value;
            const endDate = document.getElementById('customEndDate').value;
            
            if (!startDate || !endDate) {
                Swal.fire('Error', 'Please select both start and end dates', 'error');
                return;
            }
            
            if (new Date(startDate) > new Date(endDate)) {
                Swal.fire('Error', 'Start date must be before end date', 'error');
                return;
            }
            
            customStartDate = startDate;
            customEndDate = endDate;
            currentFilter = 'custom';
            
            // Update both chart AND stats
            await createChart('custom');
            await loadStats('custom', startDate, endDate);
        }

        // Create chart
        async function createChart(filter) {
            try {
                let url = `/admin/api/dashboard/sales-chart?filter=${filter}`;
                
                if (filter === 'custom' && customStartDate && customEndDate) {
                    url += `&startDate=${customStartDate}&endDate=${customEndDate}`;
                }
                
                const response = await fetch(url);
                const data = await response.json();
                
                if (!data.success) {
                    console.error('Failed to load chart data');
                    return;
                }
                
                const ctx = document.getElementById('salesChart').getContext('2d');
                
                if (currentChart) {
                    currentChart.destroy();
                }
                
                currentChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.chartData.labels,
                        datasets: [{
                            label: 'Revenue (₹)',
                            data: data.chartData.data,
                            borderColor: '#667eea',
                            backgroundColor: 'rgba(102, 126, 234, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#667eea',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return '₹' + context.parsed.y.toLocaleString('en-IN');
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        if (value >= 100000) {
                                            return '₹' + (value / 100000) + 'L';
                                        }
                                        return '₹' + (value / 1000) + 'K';
                                    }
                                },
                                grid: {
                                    color: '#f1f3f5'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            } catch (error) {
                console.error('Failed to create chart:', error);
            }
        }

        function filterChart(filter) {
            currentFilter = filter;
            customStartDate = null;
            customEndDate = null;
            
            // Hide custom date inputs
            document.getElementById('customDateInputs').style.display = 'none';
            
            // Update active button
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Update both chart AND stats
            createChart(filter);
            loadStats(filter);
        }

        async function downloadDashboardPDF() {
            try {
                Swal.fire({
                    title: 'Generating Dashboard PDF...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                let url = `/admin/api/dashboard/download-pdf?filter=${currentFilter}`;
                
                if (currentFilter === 'custom' && customStartDate && customEndDate) {
                    url += `&startDate=${customStartDate}&endDate=${customEndDate}`;
                }
                
                window.location.href = url;
                
                setTimeout(() => {
                    Swal.close();
                }, 2000);
            } catch (error) {
                Swal.close();
                console.error('Download error:', error);
                Swal.fire('Error', 'Failed to download PDF', 'error');
            }
        }

        // Load top products
        async function loadTopProducts() {
            try {
                const response = await fetch('/admin/api/dashboard/top-products');
                const data = await response.json();
                
                const container = document.getElementById('topProducts');
                
                if (data.success && data.products.length > 0) {
                    container.innerHTML = data.products.map((product, index) => {
                        const rankClass = index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '';
                        return `
                            <div class="item">
                                <div class="item-info">
                                    <div class="item-rank ${rankClass}">${index + 1}</div>
                                    <div class="item-details">
                                        <div class="item-name">${product.name}</div>
                                        <div class="item-meta">${product.brand} - ${product.category}</div>
                                    </div>
                                </div>
                                <div class="item-stats">
                                    <div class="item-value">₹${(product.totalRevenue / 100000).toFixed(1)}L</div>
                                    <div class="item-count">${product.totalSold} sold</div>
                                </div>
                            </div>
                        `;
                    }).join('');
                } else {
                    container.innerHTML = '<div class="no-data">No data available</div>';
                }
            } catch (error) {
                console.error('Failed to load top products:', error);
                document.getElementById('topProducts').innerHTML = '<div class="no-data">Failed to load data</div>';
            }
        }

        // Load top categories
        async function loadTopCategories() {
            try {
                const response = await fetch('/admin/api/dashboard/top-categories');
                const data = await response.json();
                
                const container = document.getElementById('topCategories');
                
                if (data.success && data.categories.length > 0) {
                    container.innerHTML = data.categories.map((category, index) => {
                        const rankClass = index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '';
                        return `
                            <div class="item">
                                <div class="item-info">
                                        <div class="item-rank ${rankClass}">${index + 1}</div>
                                        <div class="item-details">
                                            <div class="item-name">${category.name}</div>
                                            <div class="item-meta">Category</div>
                                        </div>
                                    </div>
                                    <div class="item-stats">
                                        <div class="item-value">₹${(category.totalRevenue / 100000).toFixed(1)}L</div>
                                        <div class="item-count">${category.totalSold} sold</div>
                                    </div>
                                </div>
                            `;
                        }).join('');
                    } else {
                        container.innerHTML = '<div class="no-data">No data available</div>';
                    }
                } catch (error) {
                    console.error('Failed to load top categories:', error);
                    document.getElementById('topCategories').innerHTML = '<div class="no-data">Failed to load data</div>';
                }
            }

            // Load top brands
            async function loadTopBrands() {
                try {
                    const response = await fetch('/admin/api/dashboard/top-brands');
                    const data = await response.json();
                    
                    const container = document.getElementById('topBrands');
                    
                    if (data.success && data.brands.length > 0) {
                        container.innerHTML = data.brands.map((brand, index) => {
                            const rankClass = index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '';
                            return `
                                <div class="item">
                                    <div class="item-info">
                                        <div class="item-rank ${rankClass}">${index + 1}</div>
                                        <div class="item-details">
                                            <div class="item-name">${brand.name}</div>
                                            <div class="item-meta">Brand</div>
                                        </div>
                                    </div>
                                    <div class="item-stats">
                                        <div class="item-value">₹${(brand.totalRevenue / 100000).toFixed(1)}L</div>
                                        <div class="item-count">${brand.totalSold} sold</div>
                                    </div>
                                </div>
                            `;
                        }).join('');
                    } else {
                        container.innerHTML = '<div class="no-data">No data available</div>';
                    }
                } catch (error) {
                    console.error('Failed to load top brands:', error);
                    document.getElementById('topBrands').innerHTML = '<div class="no-data">Failed to load data</div>';
                }
            }

            // Initialize dashboard
            document.addEventListener('DOMContentLoaded', function() {
                loadStats('monthly');
                createChart('monthly');
                loadTopProducts();
                loadTopCategories();
                loadTopBrands();
            });
    </script>
</body>
</html>
