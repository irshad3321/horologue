<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - Admin Panel</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #333;
            min-height: 100vh;
        }

        .admin-main-content {
            margin-left: 250px;
            margin-top: 70px;
            padding: 0;
            width: calc(100% - 250px);
            min-height: calc(100vh - 70px);
        }

        .dashboard-container {
            width: 100%;
            padding: 2rem;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .back-btn {
            padding: 10px 16px;
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .back-btn:hover {
            background: #545b62;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: #2c3e50;
        }

        .order-number {
            font-family: 'Courier New', monospace;
            color: #007bff;
            font-size: 16px;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            margin-bottom: 1.5rem;
        }

        .card-title {
            font-size: 18px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f1f3f5;
        }

        .order-item {
            display: grid;
            grid-template-columns: 80px 1fr auto;
            gap: 1rem;
            padding: 1rem 0;
            border-bottom: 1px solid #f1f3f5;
        }

        .order-item:last-child {
            border-bottom: none;
        }

        .item-image {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            overflow: hidden;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-info h4 {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .item-info p {
            font-size: 13px;
            color: #6c757d;
        }

        .item-price {
            text-align: right;
            font-size: 16px;
            font-weight: 600;
            color: #28a745;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f1f3f5;
        }

        .info-label {
            color: #6c757d;
            font-size: 14px;
        }

        .info-value {
            font-weight: 600;
            font-size: 14px;
        }

        .address-box {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 8px;
            font-size: 14px;
            line-height: 1.6;
        }

        .address-name {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .status-control {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .status-select {
            flex: 1;
            padding: 10px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            font-size: 14px;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: #007bff;
            color: white;
        }

        .btn-primary:hover {
            background: #0056b3;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: 700;
            padding-top: 1rem;
            margin-top: 1rem;
            border-top: 2px solid #dee2e6;
        }

        @media (max-width: 968px) {
            .admin-main-content {
                margin-left: 0;
                width: 100%;
            }

            .detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/admin-navbar') %>
    <%- include('../partials/admin-sidebar', { currentPage: 'orders' }) %>
    
    <div class="admin-main-content">
        <div class="dashboard-container">
            <div class="page-header">
                <div class="header-left">
                    <button class="back-btn" onclick="window.location.href='/admin/orders'">
                        <i class="fas fa-arrow-left"></i>
                        Back
                    </button>
                    <div>
                        <h1 class="page-title">Order Details</h1>
                        <p class="order-number">#<%= order.orderNumber %></p>
                    </div>
                </div>
            </div>

            <div class="detail-grid">
                <div>
                    <!-- Order Items -->
                    <div class="card">
                        <h2 class="card-title">Order Items</h2>
                        <% order.items.forEach(item => { %>
                            <% 
                            const variant = item.product && item.product.variants ? item.product.variants.find(v => v._id.toString() === item.variantId.toString()) : null;
                            const variantImage = variant && variant.images && variant.images.length > 0 ? variant.images[0].url : 'https://via.placeholder.com/80';
                            const productName = item.product ? item.product.name : 'Product';
                            const itemStatus = item.itemStatus || 'Active';
                            %>
                            <div class="order-item" style="<%= itemStatus === 'Cancelled' ? 'opacity: 0.7; background: #f8f9fa;' : '' %>">
                                <div class="item-image">
                                    <img src="<%= variantImage %>" alt="<%= productName %>">
                                </div>
                                <div class="item-info">
                                    <h4>
                                        <%= productName %>
                                        <% if (itemStatus === 'Cancelled') { %>
                                            <span style="background: #dc3545; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px; margin-left: 8px;">
                                                Cancelled
                                            </span>
                                        <% } %>
                                    </h4>
                                    <p>Color: <%= item.color %></p>
                                    <p>Quantity: <%= item.quantity %> × ₹<%= item.price.toLocaleString('en-IN') %></p>
                                    <% if (itemStatus === 'Cancelled' && item.cancelledDate) { %>
                                        <p style="color: #dc3545; font-size: 13px; margin-top: 8px;">
                                            Cancelled on <%= new Date(item.cancelledDate).toLocaleDateString('en-IN') %>
                                        </p>
                                        <% if (item.cancellationReason) { %>
                                            <p style="color: #6c757d; font-size: 13px;">
                                                Reason: <%= item.cancellationReason %>
                                            </p>
                                        <% } %>
                                    <% } %>
                                </div>
                                <div class="item-price" style="<%= itemStatus === 'Cancelled' ? 'text-decoration: line-through; color: #6c757d;' : '' %>">
                                    ₹<%= item.itemTotal.toLocaleString('en-IN') %>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <!-- Customer Details -->
                    <div class="card">
                        <h2 class="card-title">Customer Details</h2>
                        <div class="info-row">
                            <span class="info-label">Name</span>
                            <span class="info-value"><%= order.userId.firstName %> <%= order.userId.lastName %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Email</span>
                            <span class="info-value"><%= order.userId.email %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Phone</span>
                            <span class="info-value"><%= order.shippingAddress.phone %></span>
                        </div>
                    </div>

                    <!-- Shipping Address -->
                    <div class="card">
                        <h2 class="card-title">Shipping Address</h2>
                        <div class="address-box">
                            <div class="address-name"><%= order.shippingAddress.fullName %></div>
                            <%= order.shippingAddress.addressLine1 %><% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %><br>
                            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %><br>
                            Phone: <%= order.shippingAddress.phone %>
                        </div>
                    </div>
                </div>

                <div>
                    <!-- Order Status -->
                    <div class="card">
                        <h2 class="card-title">Order Status</h2>
                        
                        <% if (order.orderStatus === 'Return Requested') { %>
                            <!-- Return Request Section -->
                            <div style="background: #fff3cd; padding: 16px; border-radius: 8px; margin-bottom: 16px;">
                                <h3 style="color: #856404; font-size: 16px; margin-bottom: 8px;">
                                    <i class="fas fa-exclamation-triangle"></i> Return Request Pending
                                </h3>
                                <% if (order.cancellationReason) { %>
                                    <p style="font-size: 14px; color: #856404; margin-bottom: 12px;">
                                        <strong>Reason:</strong> <%= order.cancellationReason %>
                                    </p>
                                <% } %>
                                <div style="display: flex; gap: 10px;">
                                    <button class="btn" style="background: #28a745; color: white;" onclick="approveReturn()">
                                        <i class="fas fa-check"></i> Approve Return
                                    </button>
                                    <button class="btn" style="background: #dc3545; color: white;" onclick="declineReturn()">
                                        <i class="fas fa-times"></i> Decline Return
                                    </button>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- Status Dropdown -->
                            <% const isFinalState = ['Cancelled', 'Delivered', 'Returned'].includes(order.orderStatus); %>
                            <div class="status-control">
                                <select id="statusSelect" class="status-select" <%= isFinalState ? 'disabled' : '' %>>
                                    <option value="Pending" <%= order.orderStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="Confirmed" <%= order.orderStatus === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                                    <option value="Shipped" <%= order.orderStatus === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                    <option value="Delivered" <%= order.orderStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                    <option value="Cancelled" <%= order.orderStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                    <!-- <option value="Returned" <%= order.orderStatus === 'Returned' ? 'selected' : '' %>>Returned</option> -->
                                </select>
                                <button class="btn btn-primary" onclick="updateStatus()" <%= isFinalState ? 'disabled' : '' %>>
                                    Update
                                </button>
                            </div>
                        <% } %>
                    </div>

                    <!-- Order Info -->
                    <div class="card">
                        <h2 class="card-title">Order Information</h2>
                        <div class="info-row">
                            <span class="info-label">Order Date</span>
                            <span class="info-value"><%= new Date(order.orderDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Payment Method</span>
                            <span class="info-value"><%= order.paymentMethod %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Payment Status</span>
                            <span class="info-value"><%= order.paymentStatus %></span>
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="card">
                        <h2 class="card-title">Order Summary</h2>
                        <div class="info-row">
                            <span class="info-label">Subtotal</span>
                            <span class="info-value">₹<%= order.subtotal.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Discount</span>
                            <span class="info-value" style="color: #28a745;">-₹<%= order.discount.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Shipping</span>
                            <span class="info-value">₹<%= order.shippingCharge.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="summary-total">
                            <span>Total</span>
                            <span>₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/session-protection.js"></script>
    <script>
        async function updateStatus() {
            const newStatus = document.getElementById('statusSelect').value;
            
            try {
                const response = await fetch('/admin/api/orders/<%= order._id %>/status', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: 'Order status updated successfully',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Failed to update status', 'error');
            }
        }

        async function approveReturn() {
            const result = await Swal.fire({
                title: 'Approve Return?',
                text: 'Stock will be restored and order marked as returned',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Approve',
                cancelButtonText: 'Cancel'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch('/admin/api/orders/<%= order._id %>/status', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: 'Returned' })
                    });

                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Approved!',
                            text: 'Return request approved successfully',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    Swal.fire('Error', 'Failed to approve return', 'error');
                }
            }
        }

        async function declineReturn() {
            // First ask for reason
            const { value: reason } = await Swal.fire({
                title: 'Decline Return Request',
                input: 'textarea',
                inputLabel: 'Reason for declining (required)',
                inputPlaceholder: 'Enter reason for declining the return request...',
                inputAttributes: {
                    'aria-label': 'Enter reason for declining'
                },
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Decline Return',
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value || value.trim() === '') {
                        return 'Please provide a reason for declining!'
                    }
                }
            });

            if (reason) {
                try {
                    const response = await fetch('/admin/api/orders/<%= order._id %>/status', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            status: 'Return Declined',
                            declineReason: reason
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Declined!',
                            text: 'Return request declined',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    Swal.fire('Error', 'Failed to decline return', 'error');
                }
            }
        }
    </script>
</body>
</html>
