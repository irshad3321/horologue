<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Verify Code - Horologue</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #e8ecef 0%, #d6dde4 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    .header {
      background: #000;
      color: #fff;
      padding: 20px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: 1px;
    }

    .logo svg {
      width: 28px;
      height: 28px;
    }

    .admin-info {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 16px;
      font-weight: 500;
    }

    .admin-info svg {
      width: 20px;
      height: 20px;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 20px;
    }

    .verify-container {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 50px 60px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 450px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      text-align: center;
    }

    .icon-container {
      width: 80px;
      height: 80px;
      background: rgba(0, 0, 0, 0.05);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 30px;
    }

    .icon-container svg {
      width: 40px;
      height: 40px;
      color: #666;
    }

    .verify-title {
      font-size: 32px;
      font-weight: 600;
      color: #333;
      margin-bottom: 20px;
      letter-spacing: -0.5px;
    }

    .verify-subtitle {
      font-size: 16px;
      color: #666;
      margin-bottom: 30px;
      line-height: 1.5;
    }

    .email-display {
      background: rgba(0, 0, 0, 0.05);
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 14px;
      color: #333;
      margin-bottom: 30px;
      font-weight: 500;
    }

    /* Alert Messages */
    .alert {
      padding: 15px 20px;
      border-radius: 12px;
      margin-bottom: 25px;
      font-size: 14px;
      font-weight: 500;
    }

    .alert-error {
      background-color: #fee;
      color: #c53030;
      border: 1px solid #feb2b2;
    }

    .alert-success {
      background-color: #f0fff4;
      color: #2f855a;
      border: 1px solid #9ae6b4;
    }

    .otp-container {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 30px;
    }

    .otp-input {
      width: 50px;
      height: 50px;
      border: 2px solid #e1e5e9;
      border-radius: 12px;
      text-align: center;
      font-size: 18px;
      font-weight: 600;
      color: #333;
      outline: none;
      transition: all 0.3s ease;
      background: #fff;
    }

    .otp-input:focus {
      border-color: #000;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
    }

    .timer {
      font-size: 14px;
      color: #666;
      margin-bottom: 30px;
      font-weight: 500;
    }

    .verify-btn {
      width: 100%;
      padding: 18px;
      background: #000;
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .verify-btn:hover {
      background: #333;
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    }

    .verify-btn:active {
      transform: translateY(0);
    }

    .resend-link {
      color: #666;
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 20px;
      display: block;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: color 0.3s ease;
    }

    .resend-link:hover {
      color: #000;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #666;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: color 0.3s ease;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .back-link:hover {
      color: #000;
    }

    .back-link svg {
      width: 16px;
      height: 16px;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 30px 20px;
      color: #999;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .header {
        padding: 15px 20px;
      }

      .logo {
        font-size: 24px;
      }

      .logo svg {
        width: 24px;
        height: 24px;
      }

      .admin-info {
        font-size: 14px;
      }

      .verify-container {
        padding: 40px 30px;
        margin: 20px;
        border-radius: 16px;
      }

      .verify-title {
        font-size: 28px;
        margin-bottom: 15px;
      }

      .verify-subtitle {
        font-size: 15px;
        margin-bottom: 25px;
      }

      .otp-container {
        gap: 8px;
      }

      .otp-input {
        width: 45px;
        height: 45px;
        font-size: 16px;
      }

      .verify-btn {
        padding: 16px;
        font-size: 13px;
      }
    }

    @media (max-width: 480px) {
      .main-content {
        padding: 40px 15px;
      }

      .verify-container {
        padding: 30px 20px;
      }

      .verify-title {
        font-size: 24px;
      }

      .icon-container {
        width: 60px;
        height: 60px;
      }

      .icon-container svg {
        width: 30px;
        height: 30px;
      }

      .otp-input {
        width: 40px;
        height: 40px;
        font-size: 14px;
      }
    }

    /* Loading state */
    .verify-btn.loading {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .verify-btn.loading::after {
      content: '';
      width: 16px;
      height: 16px;
      border: 2px solid transparent;
      border-top: 2px solid #fff;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      display: inline-block;
      margin-left: 10px;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <%- include('../partials/toast') %>

  <!-- Header -->
  <div class="header">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      Horologue
    </div>
    <div class="admin-info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      ADMIN
    </div>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <div class="verify-container">
      <div class="icon-container">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <circle cx="12" cy="16" r="1"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>

      <h1 class="verify-title">Verify Code</h1>
      <p class="verify-subtitle">Enter the 6-digit verification code sent to your email address.</p>

      <% if (typeof email !== 'undefined' && email) { %>
        <div class="email-display"><%= email %></div>
      <% } %>

      <!-- Error and Success Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
      <% } %>
      
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
          <%= success %>
        </div>
      <% } %>

      <form action="/admin/verify-otp-forgot" method="POST">
        <div class="otp-container">
          <input type="text" class="otp-input" maxlength="1" name="otp1" autocomplete="off" />
          <input type="text" class="otp-input" maxlength="1" name="otp2" autocomplete="off" />
          <input type="text" class="otp-input" maxlength="1" name="otp3" autocomplete="off" />
          <input type="text" class="otp-input" maxlength="1" name="otp4" autocomplete="off" />
          <input type="text" class="otp-input" maxlength="1" name="otp5" autocomplete="off" />
          <input type="text" class="otp-input" maxlength="1" name="otp6" autocomplete="off" />
        </div>

        <div class="timer">Code expires in <span id="countdown">05:00</span></div>

        <button type="submit" class="verify-btn" id="verifyBtn">Verify & Reset Password</button>
      </form>

      <a href="#" class="resend-link" id="resendLink">Resend Code</a>
      <a href="/admin/forgot-password" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Back to Forgot Password
      </a>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer">
    Precision Engineering © 2024 Horologue Atelier
  </div>

  <script>
    // Debug: Log the values passed from server
    console.log('OTP Created At:', '<%= typeof otpCreatedAt !== "undefined" ? otpCreatedAt : "undefined" %>');
    console.log('Resend Timer Start:', '<%= typeof resendTimerStart !== "undefined" ? resendTimerStart : "undefined" %>');
    
    let resendCooldown = 60; // 1 minute cooldown
    let canResend = false; // Always start with false for 60-second cooldown
    let resendTimer = null; // Store timer reference
    
    // Calculate initial resend timer state based on session data
    <% if (typeof resendTimerStart !== 'undefined' && resendTimerStart) { %>
      const resendStartTime = <%= resendTimerStart %>;
      const currentTime = Date.now();
      const elapsedResendTime = Math.floor((currentTime - resendStartTime) / 1000);
      resendCooldown = Math.max(0, 60 - elapsedResendTime);
      canResend = resendCooldown <= 0;
      console.log('Resend timer calculated - Elapsed:', elapsedResendTime, 'Remaining:', resendCooldown, 'Can resend:', canResend);
    <% } else { %>
      // First time loading, start with 60-second cooldown
      canResend = false;
      resendCooldown = 60;
      console.log('First time loading, starting 60-second resend cooldown');
    <% } %>
    
    // Initialize resend link state
    function updateResendLink() {
      const resendLink = document.getElementById('resendLink');
      if (canResend) {
        resendLink.textContent = 'Resend Code';
        resendLink.style.opacity = '1';
        resendLink.style.cursor = 'pointer';
        console.log('Resend link: CLICKABLE');
      } else {
        resendLink.textContent = `Resend Code (${resendCooldown}s)`;
        resendLink.style.opacity = '0.5';
        resendLink.style.cursor = 'not-allowed';
        console.log('Resend link: COUNTDOWN -', resendCooldown, 'seconds');
      }
    }
    
    // Start cooldown timer
    function startResendCooldown() {
      if (resendTimer) return; // Don't start if already running
      if (canResend) return; // Don't start if can already resend
      if (resendCooldown <= 0) return; // Don't start if no time left
      
      console.log('Starting resend cooldown timer with', resendCooldown, 'seconds remaining');
      
      resendTimer = setInterval(() => {
        resendCooldown--;
        console.log('Resend countdown:', resendCooldown);
        updateResendLink();
        
        if (resendCooldown <= 0) {
          clearInterval(resendTimer);
          resendTimer = null;
          canResend = true;
          resendCooldown = 60; // Reset for next time
          updateResendLink();
          console.log('Resend cooldown completed - button now clickable');
        }
      }, 1000);
    }
    
    // Handle resend click
    document.getElementById('resendLink').addEventListener('click', async function(e) {
      e.preventDefault();
      
      if (!canResend) return;
      
      try {
        const response = await fetch('/admin/resend-otp-forgot', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const result = await response.json();
        
        if (result.success) {
          toastManager.success(result.message, 'Code Sent');
          // Reset resend timer after successful resend
          canResend = false;
          resendCooldown = 60;
          startResendCooldown();
        } else {
          toastManager.error(result.message, 'Resend Failed');
        }
      } catch (error) {
        console.error('Resend error:', error);
        toastManager.error('Failed to resend code. Please try again.', 'Network Error');
      }
    });
    
    // Initialize resend link state and start countdown immediately
    updateResendLink();
    
    // Start the countdown timer immediately if needed
    if (!canResend && resendCooldown > 0) {
      startResendCooldown();
    }

    // Combine OTP inputs into single field before submission
    document.querySelector('form').addEventListener('submit', function(e) {
      const otpInputs = document.querySelectorAll('.otp-input');
      let otp = '';
      otpInputs.forEach(input => otp += input.value);
      
      // Create hidden input with combined OTP
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'otp';
      hiddenInput.value = otp;
      this.appendChild(hiddenInput);

      // Show loading state
      const btn = document.getElementById('verifyBtn');
      btn.classList.add('loading');
      btn.disabled = true;
    });

    // OTP input navigation
    const otpInputs = document.querySelectorAll('.otp-input');
    
    otpInputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        if (e.target.value.length === 1 && index < otpInputs.length - 1) {
          otpInputs[index + 1].focus();
        }
      });
      
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
          otpInputs[index - 1].focus();
        }
      });
    });

    // Countdown timer - calculate remaining time based on OTP creation
    let timeLeft = 300; // Default 5 minutes
    const countdown = document.getElementById('countdown');
    
    // Try to get actual remaining time from server if available
    <% if (typeof otpCreatedAt !== 'undefined' && otpCreatedAt) { %>
      try {
        const otpCreatedTime = new Date('<%= otpCreatedAt %>').getTime();
        const currentTime = Date.now();
        const elapsedTime = Math.floor((currentTime - otpCreatedTime) / 1000);
        timeLeft = Math.max(0, 300 - elapsedTime); // 5 minutes minus elapsed time
        console.log('OTP timer calculated - Created:', new Date('<%= otpCreatedAt %>'), 'Elapsed:', elapsedTime, 'Remaining:', timeLeft);
      } catch (error) {
        console.error('Error calculating OTP time:', error);
        timeLeft = 300; // Fallback to 5 minutes
      }
    <% } else { %>
      console.log('No OTP creation time available, using default 5 minutes');
    <% } %>
    
    // Start the expiration countdown
    function startExpirationTimer() {
      const expirationTimer = setInterval(() => {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        countdown.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        
        if (timeLeft <= 0) {
          clearInterval(expirationTimer);
          countdown.textContent = 'Expired';
          console.log('OTP expired');
        }
        timeLeft--;
      }, 1000);
    }
    
    // Start the expiration timer
    startExpirationTimer();

    // Auto-focus on first OTP input
    document.addEventListener('DOMContentLoaded', function() {
      otpInputs[0].focus();
    });

    // Auto-hide error messages after 3 seconds
    setTimeout(function() {
        const errorMessages = document.querySelectorAll('.alert-error');
        
        errorMessages.forEach(function(errorMsg) {
            if (errorMsg && errorMsg.textContent.trim()) {
                errorMsg.style.transition = 'opacity 0.5s ease-out';
                errorMsg.style.opacity = '0';
                setTimeout(function() {
                    errorMsg.style.display = 'none';
                }, 500);
            }
        });
    }, 3000); // Hide after 3 seconds
  </script>
</body>
</html>