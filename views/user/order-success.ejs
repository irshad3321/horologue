<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Successful</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"/>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f4f4f8;
      font-family: 'Segoe UI', sans-serif;
      padding: 2rem 1rem;
      position: relative;
      overflow: hidden;
    }

    canvas#confetti-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    .card {
      background: #ffffff;
      border-radius: 20px;
      padding: 2.5rem 2rem;
      max-width: 420px;
      width: 100%;
      text-align: center;
      position: relative;
      z-index: 1;
      box-shadow: 0 8px 32px rgba(0,0,0,0.08);
      opacity: 0;
      transform: scale(0.85) translateY(30px);
      transition: opacity 0.6s cubic-bezier(.34,1.56,.64,1),
                  transform 0.6s cubic-bezier(.34,1.56,.64,1);
    }

    .card.visible {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    .check-wrap {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: #e6f9f0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      transform: scale(0);
      transition: transform 0.5s cubic-bezier(.34,1.8,.64,1) 0.4s;
    }

    .check-wrap.visible {
      transform: scale(1);
    }

    .check-wrap i {
      font-size: 40px;
      color: #1D9E75;
    }

    h2 {
      font-size: 22px;
      font-weight: 600;
      color: #1a1a2e;
      margin-bottom: 0.4rem;
    }

    .subtitle {
      font-size: 15px;
      color: #6b7280;
      margin-bottom: 1.8rem;
      line-height: 1.6;
    }

    .order-summary {
      background: #f9f9fb;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .order-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.6rem;
    }

    .order-row:last-child {
      margin-bottom: 0;
    }

    .order-row .label {
      font-size: 13px;
      color: #6b7280;
    }

    .order-row .value {
      font-size: 13px;
      font-weight: 600;
      color: #1a1a2e;
    }

    .order-row .value.green {
      color: #1D9E75;
    }

    .btn-group {
      display: flex;
      gap: 10px;
    }

    .btn {
      flex: 1;
      padding: 11px;
      font-size: 14px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 500;
      border: 1.5px solid #e5e7eb;
      background: #fff;
      color: #1a1a2e;
      transition: background 0.2s, transform 0.1s;
    }

    .btn:hover {
      background: #f3f4f6;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn.primary {
      background: #1D9E75;
      color: #fff;
      border-color: #1D9E75;
    }

    .btn.primary:hover {
      background: #179067;
    }
  </style>
</head>
<body>

  <canvas id="confetti-canvas"></canvas>

  <div class="card" id="card">
    <div class="check-wrap" id="checkWrap">
      <i class="ti ti-check"></i>
    </div>

    <h2>Order Placed!</h2>
    <p class="subtitle">
      Thank you for your purchase. Your items are being packed
      and will be on their way soon.
    </p>

    <div class="order-summary">
      <div class="order-row">
        <span class="label">Order ID</span>
        <span class="value">#<%= order.orderNumber %></span>
      </div>
      <div class="order-row">
        <span class="label">Order Date</span>
        <span class="value"><%= new Date(order.orderDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
      </div>
      <div class="order-row">
        <span class="label">Total Paid</span>
        <span class="value green">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
      </div>
      <div class="order-row">
        <span class="label">Payment Method</span>
        <span class="value"><%= order.paymentMethod %></span>
      </div>
    </div>

    <div class="btn-group">
      <button class="btn primary" onclick="window.location.href='/orders/<%= order._id %>'">
        Track Order
      </button>
      <button class="btn" onclick="window.location.href='/products'">
        Continue Shopping
      </button>
    </div>
  </div>

  <script>
    // ---- Animate card in ----
    const card = document.getElementById('card');
    const checkWrap = document.getElementById('checkWrap');

    setTimeout(() => card.classList.add('visible'), 100);
    setTimeout(() => checkWrap.classList.add('visible'), 400);

    // ---- Success Sound ----
    function playSuccess() {
      try {
        const ac = new (window.AudioContext || window.webkitAudioContext)();
        const notes = [523, 659, 784, 1047];
        notes.forEach((freq, i) => {
          const osc = ac.createOscillator();
          const gain = ac.createGain();
          osc.connect(gain);
          gain.connect(ac.destination);
          osc.type = 'sine';
          osc.frequency.value = freq;
          const t = ac.currentTime + i * 0.13;
          gain.gain.setValueAtTime(0, t);
          gain.gain.linearRampToValueAtTime(0.2, t + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
          osc.start(t);
          osc.stop(t + 0.4);
        });
      } catch (e) {
        console.warn('Audio not supported');
      }
    }

    // ---- Confetti ----
    const canvas = document.getElementById('confetti-canvas');
    const ctx = canvas.getContext('2d');
    const colors = ['#7F77DD','#1D9E75','#EF9F27','#D4537E','#378ADD','#D85A30'];
    let pieces = [];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    function spawnConfetti() {
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;
      for (let i = 0; i < 150; i++) {
        pieces.push({
          x: cx + (Math.random() - 0.5) * 100,
          y: cy - 50,
          vx: (Math.random() - 0.5) * 10,
          vy: -(Math.random() * 12 + 4),
          r: Math.random() * 6 + 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          rot: Math.random() * Math.PI * 2,
          rotV: (Math.random() - 0.5) * 0.2,
          shape: Math.random() > 0.5 ? 'rect' : 'circle',
          life: 1
        });
      }
    }

    function loop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = pieces.length - 1; i >= 0; i--) {
        const p = pieces[i];
        p.x += p.vx;
        p.vy += 0.3;
        p.y += p.vy;
        p.rot += p.rotV;
        p.vx *= 0.99;
        p.life -= 0.012;

        if (p.life <= 0 || p.y > canvas.height + 20) {
          pieces.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.globalAlpha = Math.min(p.life, 1);
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;

        if (p.shape === 'rect') {
          ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        } else {
          ctx.beginPath();
          ctx.arc(0, 0, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      if (pieces.length > 0) requestAnimationFrame(loop);
    }

    resize();
    window.addEventListener('resize', resize);

    // ---- Trigger everything ----
    setTimeout(() => {
      playSuccess();
      spawnConfetti();
      loop();
    }, 700);
  </script>
</body>
</html>