<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Verify Registration - Horologue</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      min-height: 100vh;
      background-color: #e8ecef;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', sans-serif;
    }

    .card {
      background: #fff;
      border-radius: 16px;
      padding: 40px;
      width: 400px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    }

    .logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 18px;
      font-weight: 700;
      color: #111;
      margin-bottom: 32px;
    }

    .logo svg {
      width: 22px;
      height: 22px;
    }

    .icon {
      width: 60px;
      height: 60px;
      background: #e8f5e8;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
    }

    .icon svg {
      width: 28px;
      height: 28px;
      color: #28a745;
    }

    h2 {
      font-size: 20px;
      font-weight: 600;
      color: #111;
      margin-bottom: 8px;
    }

    .subtitle {
      font-size: 14px;
      color: #666;
      margin-bottom: 32px;
      line-height: 1.4;
    }

    .email-display {
      background: #f8f9fa;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      color: #333;
      margin-bottom: 24px;
      font-weight: 500;
    }

    /* Alert Messages */
    .alert {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      font-weight: 500;
    }

    .alert-error {
      background-color: #fee;
      color: #c53030;
      border: 1px solid #feb2b2;
    }

    .alert-success {
      background-color: #f0fff4;
      color: #2f855a;
      border: 1px solid #9ae6b4;
    }

    .otp-container {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 24px;
    }

    .otp-input {
      width: 50px;
      height: 50px;
      border: 1.5px solid #e0e0e0;
      border-radius: 8px;
      text-align: center;
      font-size: 18px;
      font-weight: 600;
      color: #333;
      outline: none;
      transition: border 0.2s;
    }

    .otp-input:focus {
      border-color: #28a745;
    }

    .timer {
      font-size: 14px;
      color: #666;
      margin-bottom: 24px;
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      background: #28a745;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      margin-bottom: 16px;
    }

    .btn-submit:hover { background: #218838; }

    .resend-link {
      color: #666;
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 20px;
      display: block;
    }

    .resend-link:hover { text-decoration: underline; }

    .back-link {
      color: #666;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <%- include('../partials/toast') %>
  
  <div class="card">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      Horologue
    </div>

    <div class="icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    </div>

    <h2>Complete Registration</h2>
    <p class="subtitle">Enter the 6-digit verification code sent to your email to complete your registration.</p>

    <% if (email) { %>
      <div class="email-display"><%= email %></div>
    <% } %>

    <!-- Error and Success Messages -->
    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>
    
    <% if (success) { %>
      <div class="alert alert-success">
        <%= success %>
      </div>
    <% } %>

    <form action="/verify-otp-registration" method="POST">
      <div class="otp-container">
        <input type="text" class="otp-input" maxlength="1" name="otp1" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp2" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp3" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp4" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp5" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp6" autocomplete="off" />
      </div>

      <div class="timer">Code expires in <span id="countdown">05:00</span></div>

      <button type="submit" class="btn-submit">Complete Registration</button>
    </form>

    <a href="#" class="resend-link" id="resendLink">Resend Code</a>
    <a href="/register" class="back-link">Back to Registration</a>
  </div>

  <script>
    let resendCooldown = 60; // 1 minute cooldown
    let canResend = false;
    
    // Initialize resend link state
    function updateResendLink() {
      const resendLink = document.getElementById('resendLink');
      if (canResend) {
        resendLink.textContent = 'Resend Code';
        resendLink.style.opacity = '1';
        resendLink.style.cursor = 'pointer';
      } else {
        resendLink.textContent = `Resend Code (${resendCooldown}s)`;
        resendLink.style.opacity = '0.5';
        resendLink.style.cursor = 'not-allowed';
      }
    }
    
    // Start cooldown timer
    function startResendCooldown() {
      canResend = false;
      const timer = setInterval(() => {
        resendCooldown--;
        updateResendLink();
        
        if (resendCooldown <= 0) {
          clearInterval(timer);
          canResend = true;
          resendCooldown = 60;
          updateResendLink();
        }
      }, 1000);
    }
    
    // Handle resend click
    document.getElementById('resendLink').addEventListener('click', async function(e) {
      e.preventDefault();
      
      if (!canResend) return;
      
      try {
        const response = await fetch('/resend-otp-registration', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const result = await response.json();
        
        if (result.success) {
          toastManager.success(result.message, 'OTP Sent');
          startResendCooldown();
        } else {
          toastManager.error(result.message, 'Resend Failed');
        }
      } catch (error) {
        console.error('Resend error:', error);
        toastManager.error('Failed to resend code. Please try again.', 'Network Error');
      }
    });
    
    // Start initial cooldown
    startResendCooldown();

    // Combine OTP inputs into single field before submission
    document.querySelector('form').addEventListener('submit', function(e) {
      const otpInputs = document.querySelectorAll('.otp-input');
      let otp = '';
      otpInputs.forEach(input => otp += input.value);
      
      // Create hidden input with combined OTP
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'otp';
      hiddenInput.value = otp;
      this.appendChild(hiddenInput);
    });

    // OTP input navigation
    const otpInputs = document.querySelectorAll('.otp-input');
    
    otpInputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        if (e.target.value.length === 1 && index < otpInputs.length - 1) {
          otpInputs[index + 1].focus();
        }
      });
      
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
          otpInputs[index - 1].focus();
        }
      });
    });

    // Countdown timer
    let timeLeft = 300; // 5 minutes
    const countdown = document.getElementById('countdown');
    
    const timer = setInterval(() => {
      const minutes = Math.floor(timeLeft / 60);
      const seconds = timeLeft % 60;
      countdown.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      
      if (timeLeft <= 0) {
        clearInterval(timer);
        countdown.textContent = 'Expired';
      }
      timeLeft--;
    }, 1000);
  </script>
</body>
</html>