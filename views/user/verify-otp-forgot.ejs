<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Verify Reset Code - Horologue</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      min-height: 100vh;
      background-color: #e8ecef;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', sans-serif;
    }

    .card {
      background: #fff;
      border-radius: 16px;
      padding: 40px;
      width: 400px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    }

    .logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 18px;
      font-weight: 700;
      color: #111;
      margin-bottom: 32px;
    }

    .logo svg {
      width: 22px;
      height: 22px;
    }

    .icon {
      width: 60px;
      height: 60px;
      background: #fff3cd;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
    }

    .icon svg {
      width: 28px;
      height: 28px;
      color: #dc3545;
    }

    h2 {
      font-size: 20px;
      font-weight: 600;
      color: #111;
      margin-bottom: 8px;
    }

    .subtitle {
      font-size: 14px;
      color: #666;
      margin-bottom: 32px;
      line-height: 1.4;
    }

    .email-display {
      background: #f8f9fa;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      color: #333;
      margin-bottom: 24px;
      font-weight: 500;
    }

    /* Alert Messages */
    .alert {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      font-weight: 500;
    }

    .alert-error {
      background-color: #fee;
      color: #c53030;
      border: 1px solid #feb2b2;
    }

    .alert-success {
      background-color: #f0fff4;
      color: #2f855a;
      border: 1px solid #9ae6b4;
    }

    .otp-container {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 24px;
    }

    .otp-input {
      width: 50px;
      height: 50px;
      border: 1.5px solid #e0e0e0;
      border-radius: 8px;
      text-align: center;
      font-size: 18px;
      font-weight: 600;
      color: #333;
      outline: none;
      transition: border 0.2s;
    }

    .otp-input:focus {
      border-color: #dc3545;
    }

    .timer {
      font-size: 14px;
      color: #666;
      margin-bottom: 24px;
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      background: #dc3545;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      margin-bottom: 16px;
    }

    .btn-submit:hover { background: #c82333; }

    .resend-link {
      color: #666;
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 20px;
      display: block;
    }

    .resend-link:hover { text-decoration: underline; }

    .back-link {
      color: #666;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <%- include('../partials/toast') %>
  
  <div class="card">
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      Horologue
    </div>

    <div class="icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <circle cx="12" cy="16" r="1"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>

    <h2>Reset Password</h2>
    <p class="subtitle">Enter the 6-digit verification code sent to your email to reset your password.</p>

    <% if (email) { %>
      <div class="email-display"><%= email %></div>
    <% } %>

    <!-- Error and Success Messages -->
    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>
    
    <% if (success) { %>
      <div class="alert alert-success">
        <%= success %>
      </div>
    <% } %>

    <form action="/verify-otp-forgot" method="POST">
      <div class="otp-container">
        <input type="text" class="otp-input" maxlength="1" name="otp1" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp2" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp3" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp4" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp5" autocomplete="off" />
        <input type="text" class="otp-input" maxlength="1" name="otp6" autocomplete="off" />
      </div>

      <div class="timer">Code expires in <span id="countdown">05:00</span></div>

      <button type="submit" class="btn-submit">Verify & Reset Password</button>
    </form>

    <a href="#" class="resend-link" id="resendLink">Resend Code</a>
    <a href="/forgot-password" class="back-link">Back to Forgot Password</a>
  </div>

  <script>
    // Debug: Log the values passed from server
    console.log('OTP Created At:', '<%= typeof otpCreatedAt !== "undefined" ? otpCreatedAt : "undefined" %>');
    console.log('Resend Timer Start:', '<%= typeof resendTimerStart !== "undefined" ? resendTimerStart : "undefined" %>');
    
    let resendCooldown = 60; // 1 minute cooldown
    let canResend = false; // Always start with false for 60-second cooldown
    let resendTimer = null; // Store timer reference
    
    // Calculate initial resend timer state based on session data
    <% if (typeof resendTimerStart !== 'undefined' && resendTimerStart) { %>
      const resendStartTime = <%= resendTimerStart %>;
      const currentTime = Date.now();
      const elapsedResendTime = Math.floor((currentTime - resendStartTime) / 1000);
      resendCooldown = Math.max(0, 60 - elapsedResendTime);
      canResend = resendCooldown <= 0;
      console.log('Resend timer calculated - Elapsed:', elapsedResendTime, 'Remaining:', resendCooldown, 'Can resend:', canResend);
    <% } else { %>
      // First time loading, start with 60-second cooldown
      canResend = false;
      resendCooldown = 60;
      console.log('First time loading, starting 60-second resend cooldown');
    <% } %>
    
    // Initialize resend link state
    function updateResendLink() {
      const resendLink = document.getElementById('resendLink');
      if (canResend) {
        resendLink.textContent = 'Resend Code';
        resendLink.style.opacity = '1';
        resendLink.style.cursor = 'pointer';
        console.log('Resend link: CLICKABLE');
      } else {
        resendLink.textContent = `Resend Code (${resendCooldown}s)`;
        resendLink.style.opacity = '0.5';
        resendLink.style.cursor = 'not-allowed';
        console.log('Resend link: COUNTDOWN -', resendCooldown, 'seconds');
      }
    }
    
    // Start cooldown timer
    function startResendCooldown() {
      if (resendTimer) return; // Don't start if already running
      if (canResend) return; // Don't start if can already resend
      if (resendCooldown <= 0) return; // Don't start if no time left
      
      console.log('Starting resend cooldown timer with', resendCooldown, 'seconds remaining');
      
      resendTimer = setInterval(() => {
        resendCooldown--;
        console.log('Resend countdown:', resendCooldown);
        updateResendLink();
        
        if (resendCooldown <= 0) {
          clearInterval(resendTimer);
          resendTimer = null;
          canResend = true;
          resendCooldown = 60; // Reset for next time
          updateResendLink();
          console.log('Resend cooldown completed - button now clickable');
        }
      }, 1000);
    }
    
    // Handle resend click
    document.getElementById('resendLink').addEventListener('click', async function(e) {
      e.preventDefault();
      
      if (!canResend) return;
      
      try {
        const response = await fetch('/resend-otp-forgot', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const result = await response.json();
        
        if (result.success) {
          toastManager.success(result.message, 'OTP Sent');
          // Reset resend timer after successful resend
          canResend = false;
          resendCooldown = 60;
          startResendCooldown();
        } else {
          toastManager.error(result.message, 'Resend Failed');
        }
      } catch (error) {
        console.error('Resend error:', error);
        toastManager.error('Failed to resend code. Please try again.', 'Network Error');
      }
    });
    
    // Initialize resend link state and start countdown immediately
    updateResendLink();
    
    // Start the countdown timer immediately if needed
    if (!canResend && resendCooldown > 0) {
      startResendCooldown();
    }

    // Combine OTP inputs into single field before submission
    document.querySelector('form').addEventListener('submit', function(e) {
      const otpInputs = document.querySelectorAll('.otp-input');
      let otp = '';
      otpInputs.forEach(input => otp += input.value);
      
      // Create hidden input with combined OTP
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'otp';
      hiddenInput.value = otp;
      this.appendChild(hiddenInput);
    });

    // OTP input navigation
    const otpInputs = document.querySelectorAll('.otp-input');
    
    otpInputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        if (e.target.value.length === 1 && index < otpInputs.length - 1) {
          otpInputs[index + 1].focus();
        }
      });
      
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
          otpInputs[index - 1].focus();
        }
      });
    });

    // Countdown timer - calculate remaining time based on OTP creation
    let timeLeft = 300; // Default 5 minutes
    const countdown = document.getElementById('countdown');
    
    // Try to get actual remaining time from server if available
    <% if (typeof otpCreatedAt !== 'undefined' && otpCreatedAt) { %>
      try {
        const otpCreatedTime = new Date('<%= otpCreatedAt %>').getTime();
        const currentTime = Date.now();
        const elapsedTime = Math.floor((currentTime - otpCreatedTime) / 1000);
        timeLeft = Math.max(0, 300 - elapsedTime); // 5 minutes minus elapsed time
        console.log('OTP timer calculated - Created:', new Date('<%= otpCreatedAt %>'), 'Elapsed:', elapsedTime, 'Remaining:', timeLeft);
      } catch (error) {
        console.error('Error calculating OTP time:', error);
        timeLeft = 300; // Fallback to 5 minutes
      }
    <% } else { %>
      console.log('No OTP creation time available, using default 5 minutes');
    <% } %>
    
    // Start the expiration countdown
    function startExpirationTimer() {
      const expirationTimer = setInterval(() => {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        countdown.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        
        if (timeLeft <= 0) {
          clearInterval(expirationTimer);
          countdown.textContent = 'Expired';
          console.log('OTP expired');
        }
        timeLeft--;
      }, 1000);
    }
    
    // Start the expiration timer
    startExpirationTimer();

    // Auto-hide error messages after 3 seconds
    setTimeout(function() {
        const errorMessages = document.querySelectorAll('.alert-error');
        
        errorMessages.forEach(function(errorMsg) {
            if (errorMsg && errorMsg.textContent.trim()) {
                errorMsg.style.transition = 'opacity 0.5s ease-out';
                errorMsg.style.opacity = '0';
                setTimeout(function() {
                    errorMsg.style.display = 'none';
                }, 500);
            }
        });
    }, 3000); // Hide after 3 seconds
  </script>
</body>
</html>