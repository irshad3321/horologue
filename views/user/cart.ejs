<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - Horologue</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fff;
            color: #333;
            padding-top: 80px;
            line-height: 1.6;
        }

        .page-header {
            background: #fff;
            padding: 60px 0 40px;
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 30% 20%, rgba(102, 126, 234, 0.05) 0%, transparent 50%);
        }

        .page-header-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 40px;
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-header-left {
            flex: 1;
        }

        .btn-clear {
            padding: 12px 24px;
            background: white;
            color: #dc3545;
            border: 2px solid #dc3545;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-clear:hover {
            background: #dc3545;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.3);
        }

        .page-title {
            font-size: 42px;
            font-weight: 900;
            color: #111;
            margin-bottom: 8px;
            letter-spacing: -1px;
        }

        .page-subtitle {
            font-size: 16px;
            color: #666;
            font-weight: 300;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 40px 80px;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 32px;
        }

        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .cart-item {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(0, 0, 0, 0.05);
            display: grid;
            grid-template-columns: 140px 1fr auto;
            gap: 24px;
            align-items: center;
            transition: all 0.3s ease;
        }

        .cart-item:hover {
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
        }

        .item-image {
            width: 140px;
            height: 140px;
            border-radius: 16px;
            overflow: hidden;
            background: #f8f9fa;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-details {
            flex: 1;
        }

        .item-category {
            font-size: 12px;
            color: #667eea;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .item-name {
            font-size: 20px;
            font-weight: 700;
            color: #111;
            margin-bottom: 8px;
        }

        .item-variant {
            font-size: 14px;
            color: #666;
            margin-bottom: 8px;
        }

        .item-stock {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .item-stock.in-stock {
            color: #28a745;
        }

        .item-stock.low-stock {
            color: #ffc107;
        }

        .item-stock.out-of-stock {
            color: #dc3545;
        }

        .item-price {
            font-size: 24px;
            font-weight: 900;
            color: #28a745;
        }

        .item-actions {
            display: flex;
            flex-direction: column;
            gap: 16px;
            align-items: flex-end;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            overflow: hidden;
        }

        .qty-btn {
            padding: 10px 16px;
            border: none;
            background: white;
            cursor: pointer;
            font-size: 16px;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .qty-btn:hover:not(:disabled) {
            background: #f8f9fa;
        }

        .qty-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .qty-input {
            width: 50px;
            text-align: center;
            border: none;
            font-size: 16px;
            font-weight: 700;
            padding: 10px 0;
        }

        .remove-btn {
            background: none;
            border: none;
            color: #dc3545;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s ease;
        }

        .remove-btn:hover {
            color: #c82333;
        }

        .order-summary {
            background: white;
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 100px;
            height: fit-content;
        }

        .summary-title {
            font-size: 24px;
            font-weight: 700;
            color: #111;
            margin-bottom: 24px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 16px;
            font-size: 16px;
        }

        .summary-label {
            color: #666;
        }

        .summary-value {
            font-weight: 600;
            color: #111;
        }

        .summary-divider {
            height: 1px;
            background: #e9ecef;
            margin: 20px 0;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            font-size: 24px;
            font-weight: 900;
            color: #111;
            margin-bottom: 24px;
        }

        .checkout-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }

        .checkout-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(102, 126, 234, 0.4);
        }

        .checkout-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .continue-shopping {
            width: 100%;
            padding: 16px;
            background: white;
            color: #111;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 12px;
            text-decoration: none;
        }

        .continue-shopping:hover {
            border-color: #667eea;
            color: #667eea;
        }

        .empty-cart {
            text-align: center;
            padding: 80px 40px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        }

        .empty-icon {
            width: 120px;
            height: 120px;
            margin: 0 auto 32px;
            background: #f8f9fa;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 56px;
            color: #adb5bd;
        }

        .empty-title {
            font-size: 32px;
            font-weight: 700;
            color: #111;
            margin-bottom: 16px;
        }

        .empty-description {
            font-size: 18px;
            color: #666;
            margin-bottom: 32px;
            font-weight: 300;
        }

        .btn-shop {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 16px 32px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 700;
            transition: all 0.3s ease;
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-shop:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(102, 126, 234, 0.4);
        }

        @media (max-width: 968px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }

            .order-summary {
                position: static;
            }

            .cart-item {
                grid-template-columns: 100px 1fr;
                gap: 16px;
            }

            .item-actions {
                grid-column: 1 / -1;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
            }

            .item-image {
                width: 100px;
                height: 100px;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 40px 20px;
            }

            .page-header-content {
                padding: 0 20px;
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .btn-clear {
                width: 100%;
            }

            .page-title {
                font-size: 32px;
            }
        }

        /* Pagination Styles */
        .pagination-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 16px;
            margin-top: 32px;
            padding: 24px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        .pagination-info {
            font-size: 14px;
            color: #666;
            font-weight: 500;
        }

        .pagination-buttons {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .page-btn {
            padding: 10px 16px;
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .page-btn:hover:not(:disabled) {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            border-color: #ddd;
            color: #999;
        }

        .page-number {
            padding: 10px 16px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-left">
                <h1 class="page-title">Shopping Cart</h1>
                
            </div>
            <% if (cart.items && cart.items.length > 0) { %>
                <button class="btn-clear" onclick="clearCart()">
                    <i class="fas fa-trash-alt"></i>
                    Clear Cart
                </button>
            <% } %>
        </div>
    </div>

    <div class="container">
        <% if (cart.allItems && cart.allItems.length > 0) { %>
            <% 
            // Calculate totals from ALL items (not just paginated)
            let subtotal = 0;
            let totalItemsCount = 0;
            let hasOutOfStock = false;
            let hasUnavailable = false;
            
            cart.allItems.forEach(item => {
                const product = item.product;
                const variant = product.variants.id(item.variantId);
                
                // Check if product is unavailable or brand deactivated
                if (product.status !== 'active' || product.brandStatus === 'inactive') {
                    hasUnavailable = true;
                    hasOutOfStock = true; // Also set hasOutOfStock for checkout blocking
                } else if (variant && variant.stock > 0) {
                    let itemPrice = variant.price;
                    if (product.offer > 0) {
                        itemPrice = variant.price - (variant.price * product.offer / 100);
                    }
                    subtotal += itemPrice * item.quantity;
                    totalItemsCount += item.quantity;
                } else {
                    hasOutOfStock = true;
                }
            });
            %>
            
            <div class="cart-layout">
                <!-- Cart Items -->
                <div class="cart-items">
                    <% cart.items.forEach(item => { %>
                        <% 
                        const product = item.product;
                        const variant = product.variants.id(item.variantId);
                          
                        // Handle missing variant (deleted or ID changed)
                        if (!variant) {
                            hasOutOfStock = true;
                        
                            // Try to get image from first available variant
                            let fallbackImage = 'https://via.placeholder.com/200?text=No+Image';
                            if (product.variants && product.variants.length > 0) {
                                const firstVariant = product.variants[0];
                                if (firstVariant.images && firstVariant.images.length > 0) {
                                    fallbackImage = firstVariant.images[0].url;
                                }
                            }
                        %>
                        <div class="cart-item" data-product-id="<%= product._id %>" data-variant-id="<%= item.variantId %>">
                            <div class="item-image">
                                <img src="<%= fallbackImage %>" alt="<%= product.name %>">
                            </div>
                            <div class="item-details">
                                <div class="item-category"><%= product.category %></div>
                                <h3 class="item-name"><%= product.name %><%=product.items.length%></h3>
                                <div class="item-variant">This variant was updated. Please remove and re-add from product page.</div>
                                <div class="item-stock out-of-stock">
                                    <i class="fas fa-exclamation-triangle"></i> Variant Updated - Please Re-add
                                </div>
                                <div class="item-price">₹0</div>
                            </div>
                            <div class="item-actions">
                                <button class="remove-btn">
                                    <i class="fas fa-trash"></i>
                                    Remove
                                </button>
                            </div>
                        </div>
                        <% return; } %>
                        
                        <% 
                        // Get variant image
                        let variantImage = 'https://via.placeholder.com/200?text=No+Image';
                        if (variant.images && variant.images.length > 0) {
                            variantImage = variant.images[0].url;
                        }
                        
                        // Calculate price with offer
                        let itemPrice = variant.price;
                        if (product.offer > 0) {
                            itemPrice = variant.price - (variant.price * product.offer / 100);
                        }
                        
                        // Check stock status
                        const isOutOfStock = variant.stock === 0;
                        const isLowStock = variant.stock > 0 && variant.stock < 5;
                        const isBrandDeactivated = product.brandStatus === 'inactive';
                        const isUnavailable = product.status !== 'active' || isBrandDeactivated;
                        %>
                        
                        <div class="cart-item" data-product-id="<%= product._id %>" data-variant-id="<%= variant._id %>">
                            <div class="item-image">
                                <img src="<%= variantImage %>" alt="<%= product.name %>">
                            </div>
                            <div class="item-details">
                                <div class="item-category"><%= product.category %></div>
                                <h3 class="item-name"><%= product.name %></h3>
                                <div class="item-variant">Color: <%= variant.color %> | Brand: <%= product.brand %></div>
                                <% if (isBrandDeactivated) { %>
                                    <div class="item-stock out-of-stock">
                                        <i class="fas fa-ban"></i> Brand Deactivated
                                    </div>
                                <% } else if (isUnavailable) { %>
                                    <div class="item-stock out-of-stock">
                                        <i class="fas fa-ban"></i> Unavailable
                                    </div>
                                <% } else if (isOutOfStock) { %>
                                    <div class="item-stock out-of-stock">
                                        <i class="fas fa-times-circle"></i> Out of Stock 
                                    </div>
                                <% } else if (isLowStock) { %>
                                    <div class="item-stock low-stock">
                                        <i class="fas fa-exclamation-circle"></i> Only <%= variant.stock %> left
                                    </div>
                                <% } else { %>
                                    <div class="item-stock in-stock">
                                        <i class="fas fa-check-circle"></i> In Stock 
                                    </div>
                                <% } %>
                                <div class="item-price">₹<%= itemPrice.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></div>
                            </div>
                            <div class="item-actions">
                                <div class="quantity-controls">
                                    <button class="qty-btn decrease-qty" <%= isOutOfStock || isUnavailable || item.quantity <= 1 ? 'disabled' : '' %>>-</button>
                                    <input type="number" class="qty-input" value="<%= item.quantity %>" min="1" max="5" readonly>
                                    <button class="qty-btn increase-qty" <%= isOutOfStock || isUnavailable || item.quantity >= 5 || item.quantity >= variant.stock ? 'disabled' : '' %>>+</button>
                                </div>
                                <button class="remove-btn">
                                    <i class="fas fa-trash"></i>
                                    Remove
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Order Summary -->
                <div class="order-summary">
                    <h2 class="summary-title">Order Summary</h2>
                    
                    <div class="summary-row">
                        <span class="summary-label">Subtotal (<%= totalItemsCount %> item<%= totalItemsCount !== 1 ? 's' : '' %>)</span>
                        <span class="summary-value">₹<%= subtotal.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label">Shipping</span>
                        <span class="summary-value" style="color: #28a745;">FREE</span>
                    </div>
                    
                    <div class="summary-divider"></div>
                    
                    <div class="summary-total">
                        <span>Total</span>
                        <span>₹<%= subtotal.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
                    </div>
                    
                    <button class="checkout-btn" <%= hasOutOfStock ? 'disabled' : '' %> onclick="window.location.href='/checkout'">
                        <i class="fas fa-lock"></i>
                        <%= hasUnavailable ? 'Remove Unavailable Items' : hasOutOfStock ? 'Remove Out of Stock Items' : 'Proceed to Checkout' %>
                    </button>
                    
                    <a href="/products" class="continue-shopping">
                        <i class="fas fa-arrow-left"></i>
                        Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="pagination-container">
                    <div class="pagination-info">
                        Showing <%= ((currentPage - 1) * 5) + 1 %>-<%= Math.min(currentPage * 5, totalItems) %> of <%= totalItems %> items
                    </div>
                    <div class="pagination-buttons">
                        <button class="page-btn" onclick="window.location.href='/cart?page=<%= currentPage - 1 %>'" <%= currentPage === 1 ? 'disabled' : '' %>>
                            <i class="fas fa-chevron-left"></i>
                            Previous
                        </button>
                        <div class="page-number">
                            Page <%= currentPage %> of <%= totalPages %>
                        </div>
                        <button class="page-btn" onclick="window.location.href='/cart?page=<%= currentPage + 1 %>'" <%= currentPage === totalPages ? 'disabled' : '' %>>
                            Next
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            <% } %>
        <% } else { %>
            <!-- Empty Cart State -->
            <div class="empty-cart">
                <div class="empty-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <h2 class="empty-title">Your Cart is Empty</h2>
                <p class="empty-description">
                    Looks like you haven't added anything to your cart yet.<br>
                    Start shopping and add your favorite watches!
                </p>
                <a href="/products" class="btn-shop">
                    <i class="fas fa-shopping-bag"></i>
                    Start Shopping
                </a>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
    <%- include('../partials/toast') %>

    <script src="/js/session-protection.js"></script>
    <script>
        // Increase quantity
        document.querySelectorAll('.increase-qty').forEach(btn => {
            btn.addEventListener('click', async function() {
                const cartItem = this.closest('.cart-item');
                const productId = cartItem.dataset.productId;
                const variantId = cartItem.dataset.variantId;
                const qtyInput = cartItem.querySelector('.qty-input');
                const newQuantity = parseInt(qtyInput.value) + 1;
                
                try {
                    const response = await fetch('/api/cart/update', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, variantId, quantity: newQuantity })
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        location.reload();
                    } else {
                        toastManager.error(data.message);
                    }
                } catch (error) {
                    toastManager.error('Error updating cart');
                }
            });
        });

        // Decrease quantity
        document.querySelectorAll('.decrease-qty').forEach(btn => {
            btn.addEventListener('click', async function() {
                const cartItem = this.closest('.cart-item');
                const productId = cartItem.dataset.productId;
                const variantId = cartItem.dataset.variantId;
                const qtyInput = cartItem.querySelector('.qty-input');
                const newQuantity = parseInt(qtyInput.value) - 1;
                
                if (newQuantity < 1) return;
                
                try {
                    const response = await fetch('/api/cart/update', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, variantId, quantity: newQuantity })
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        location.reload();
                    } else {
                        toastManager.error(data.message);
                    }
                } catch (error) {
                    toastManager.error('Error updating cart');
                }
            });
        });

        // Remove from cart
        document.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const result = await Swal.fire({
                    title: 'Remove Item?',
                    text: 'Are you sure you want to remove this item from cart?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, remove it',
                    cancelButtonText: 'Cancel'
                });
                
                if (!result.isConfirmed) return;
                
                const cartItem = this.closest('.cart-item');
                const productId = cartItem.dataset.productId;
                const variantId = cartItem.dataset.variantId;
                
                try {
                    const response = await fetch('/api/cart/remove', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, variantId })
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        toastManager.success('Item removed from cart');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        toastManager.error(data.message);
                    }
                } catch (error) {
                    toastManager.error('Error removing item');
                }
            });
        });

        // Clear entire cart
        async function clearCart() {
            const result = await Swal.fire({
                title: 'Clear Cart?',
                text: 'Are you sure you want to remove all items from your cart?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, clear it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc3545'
            });
            
            if (!result.isConfirmed) return;
            
            try {
                const response = await fetch('/api/cart/clear', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                const data = await response.json();
                
                if (data.success) {
                    toastManager.success('Cart cleared successfully');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    toastManager.error(data.message);
                }
            } catch (error) {
                toastManager.error('Error clearing cart');
            }
        }
    </script>
</body>
</html>
